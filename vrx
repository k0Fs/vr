	-- ===== buscador =====
	local SEARCH = { rows = {}, active = false }
	local function applySearch(q)
		q = string.lower(q or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if q == "" then
			if SEARCH.active then
				SEARCH.active = false
				for _, e in ipairs(SEARCH.rows) do if e.r.Parent and e.saved ~= nil then e.r.Visible = e.saved e.saved = nil end end
				for _, p in pairs(pages) do for _, g in ipairs(p.groups) do g.box.Visible = not g.removed end pcall(rebalance, p) end
			end
			return
		end
		if not SEARCH.active then
			SEARCH.active = true
			for _, e in ipairs(SEARCH.rows) do if e.r.Parent then e.saved = e.r.Visible end end
		end
		local hits = {}
		for name, p in pairs(pages) do
			local n = 0
			for _, g in ipairs(p.groups) do
				if g.removed then continue end
				local any = false
				local gt = string.lower(g.title or "")
				for _, e in ipairs(SEARCH.rows) do
					if e.g == g and e.r.Parent and e.saved ~= false then
						local m = (e.t .. " " .. gt):find(q, 1, true) ~= nil
						e.r.Visible = m
						if m then any = true n += 1 end
					end
				end
				g.box.Visible = any
			end
			hits[name] = n
			pcall(rebalance, p)
		end
		if currentTab and (hits[currentTab] or 0) == 0 then
			local best, bn = nil, 0
			for _, t in ipairs(tabList) do if (hits[t.name] or 0) > bn then best, bn = t.name, hits[t.name] end end
			if best then selectTab(best) end
		end
	end
	searchTb:GetPropertyChangedSignal("Text"):Connect(function() applySearch(searchTb.Text) end)

