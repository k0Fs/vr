					tl.TextSize = 12.5
					tl.TextColor3 = rgb(200, 200, 210)
					r.Size = UDim2.new(1, 0, 0, 32)
				end
			end
			m.kind, m.title, m.desc = "toggle", title, v.description
			rt._allToggles = rt._allToggles or {}
			table.insert(rt._allToggles, m)
			register(r, title, v.description)
			if state and v.callback then task.defer(safe, v.callback, state) end
			return m
		end

		function g:create_slider(flag, v)
			flag, v = args(flag, v)
			local mn, mx = tonumber(v.minimum) or 0, tonumber(v.maximum) or 100
			local def = math.clamp(tonumber(v.default) or mn, mn, mx)
			local value = def
			if flag and tonumber(rt._flags[flag]) then value = math.clamp(tonumber(rt._flags[flag]), mn, mx) end
			g.rows += 1
			local title = tostring(v.title or flag or "Slider")
			local r = new("Frame", { Parent = box, LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, ZIndex = 3 })
			txt(r, { Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, -70, 0, 16), Text = title, Font = FN, TextSize = 12.5, TextColor3 = rgb(200, 200, 210), ZIndex = 3 })
			local valTxt = txt(r, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 6), Size = UDim2.fromOffset(70, 16), Text = "", Font = FN, TextSize = 11.5, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3 })
			local track = new("Frame", { Parent = r, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = C.off, BorderSizePixel = 0, ZIndex = 3 }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
			local fill = new("Frame", { Parent = track, Size = UDim2.fromScale(0, 1), BackgroundColor3 = ACC, BorderSizePixel = 0, ZIndex = 4 }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
			onAcc(fill, "BackgroundColor3")
			local knob = new("Frame", { Parent = track, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 5 }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
			new("UIStroke", { Parent = knob, Color = C.win, Thickness = 2 })
			local hitBar = new("TextButton", { Parent = r, Position = UDim2.fromOffset(-4, 22), Size = UDim2.new(1, 8, 0, 24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6 })
			local function snap(x)
				local inc = tonumber(v.increment)
				if inc and inc > 0 and inc < 1 then
					local s = math.floor(x / inc + 0.5) * inc
					return math.floor(s * 1000 + 0.5) / 1000
				end
				if v.rounding == true then return math.floor(x + 0.5) end
				return math.floor(x * 10 + 0.5) / 10
			end
			local function render(val, anim)
				local a = mx > mn and (val - mn) / (mx - mn) or 0
				if anim then
					tween(fill, 0.08, { Size = UDim2.fromScale(a, 1) }, Enum.EasingStyle.Quad)
					tween(knob, 0.08, { Position = UDim2.fromScale(a, 0.5) }, Enum.EasingStyle.Quad)
				else
					fill.Size = UDim2.fromScale(a, 1)
					knob.Position = UDim2.fromScale(a, 0.5)
				end
				valTxt.Text = tostring(val) .. (v.suffix or "")
			end
			render(value)
			local m = { frame = r }
			local function commit(val, silent, anim)
				val = math.clamp(snap(val), mn, mx)
				value = val
				render(val, anim)
				if flag then rt._flags[flag] = val rt._changed() end
				if not silent then safe(v.callback, val) end
			end
			function m:set_value(val, silent) commit(tonumber(val) or mn, silent, true) end
			function m:get_value() return value end
			function m:set_visible(x) r.Visible = x end
			function m:is_visible() return r.Visible end
			if flag then rt._flags[flag] = value end
			m.kind, m.title, m.desc, m.min, m.max, m.suffix = "slider", title, v.description, mn, mx, v.suffix
			m.default = def
			if value ~= def then task.defer(safe, v.callback, value) end
			local dragging, dragInput = false, nil
			local function fromX(px) commit(mn + math.clamp((px - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1) * (mx - mn), false, false) end
			hitBar.InputBegan:Connect(function(i)
				if isPress(i) then
					dragging, dragInput = true, i
					lockScroll(true)
