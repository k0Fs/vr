		-- musica: ecualizador pequeño a la derecha
		local eqBars
		if isMusic then
			local eq = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(4 * 3 + 3 * 2, 16), BackgroundTransparency = 1, ZIndex = 3 }, card)
			eqBars = {}
			for i = 1, 4 do
				local b = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, (i - 1) * 5, 1, 0), Size = UDim2.new(0, 3, 0.3, 0), BackgroundColor3 = WHITE, ZIndex = 4 }, eq)
				corner(b)
				grad(b, { Rotation = 90, Color = cs(WHITE, RED_HI) })
				eqBars[i] = b
			end
			title.Size = UDim2.new(1, -TX - 40, 0, 18)
			sub.Size = UDim2.new(1, -TX - 40, 0, 14)
			local conn
			conn = RS2.Heartbeat:Connect(function()
				if not card.Parent then conn:Disconnect() return end
				local t = os.clock()
				for i, b in ipairs(eqBars) do
					b.Size = UDim2.new(0, 3, 0.3 + 0.7 * math.abs(math.sin(t * (4 + i * 1.3) + i)), 0)
				end
			end)
		end

		local entry = { card = card, h = H * scale, scale = scale, inset = inset, timed = o.duration ~= nil, key = key }
		local timerId = 0
		local close
		local function apply(opts, first)
			title.Text = tostring(opts.title or "VIREX")
			sub.Text = tostring(opts.text or "")
			local chipText, on = chipFor(opts.text)
			chip.Visible = chipText ~= nil and not isMusic
			if chip.Visible then
				chl.Text = chipText
				chip.BackgroundColor3 = on and RED or Color3.fromRGB(48, 40, 44)
				chl.TextColor3 = on and WHITE or Color3.fromRGB(190, 180, 184)
				title.Size = UDim2.new(1, -TX - 58, 0, 18)
				sub.Size = UDim2.new(1, -TX - 58, 0, 14)
				if not first then chipSc.Scale = 0.6 tw(chipSc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back) end
			end
			timerId += 1
			local my = timerId
			if opts.duration then
				entry.timed = true
				task.delay(opts.duration, function() if my == timerId and close then close() end end)
			end
		end
		entry.update = function(opts)
			apply(opts, false)
			-- se actualiza con un toque suave
			sc.Scale = scale * 1.03
			tw(sc, 0.4, { Scale = scale }, Enum.EasingStyle.Quint)
			tileSc.Scale = 0.8
			tw(tileSc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		table.insert(stack, 1, entry)
		if #stack > 4 then
			for i = #stack, 1, -1 do
				local e = stack[i]
				if e.timed and e ~= entry and e.close then e.close() break end
			end
		end
		relayout()
		apply(o, true)
		-- entrada: baja suave y crece un poco; el icono salta y los textos entran desde la izquierda
		tw(card, 0.35, { GroupTransparency = 0 }, Enum.EasingStyle.Quad)
		tw(sc, 0.55, { Scale = scale }, Enum.EasingStyle.Quint)
		task.delay(0.08, function() tw(tileSc, 0.55, { Scale = 1 }, Enum.EasingStyle.Back) end)
		task.delay(0.12, function()
			tw(title, 0.45, { TextTransparency = 0, Position = UDim2.fromOffset(TX, epic and 9 or 8) }, Enum.EasingStyle.Quint)
		end)
		task.delay(0.18, function()
			tw(sub, 0.45, { TextTransparency = 0.05, Position = UDim2.fromOffset(TX, epic and 29 or 26) }, Enum.EasingStyle.Quint)
		end)
		if epic then
			-- la luz roja de abajo se apaga despacio (entrada "epica" pero limpia)
			task.delay(0.3, function() tw(underG, 1.2, { Offset = Vector2.new(0, 0.25) }, Enum.EasingStyle.Quad) end)
		end

		close = function()
			if entry.closed then return end
			entry.closed = true
			for i, e in ipairs(stack) do if e == entry then table.remove(stack, i) break end end
			relayout()
			local y0 = entry.y or inset
			tw(sc, 0.3, { Scale = scale * 0.92 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			tw(card, 0.3, { Position = UDim2.new(0.5, 0, 0, y0 - 10 * scale), GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			task.delay(0.34, function() pcall(function() card:Destroy() end) end)
		end
		entry.close = close
		-- se convierte en "correcto": el icono gira como una moneda y sale el check verde
		entry.success = function(opts)
			if entry.closed or entry.won then return end
			entry.won = true
			opts = opts or {}
			tw(tileSc, 0.16, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tw(title, 0.15, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
			tw(sub, 0.15, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
			task.delay(0.17, function()
				if not card.Parent then return end
				setGreen()
				drawCheck(true)
				tw(tileSc, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
				stg.Color = cs(WHITE, GREEN_HI, GREEN)
				tint.BackgroundColor3 = GREEN
				under.BackgroundColor3 = GREEN
				title.Text = tostring(opts.title or title.Text)
				sub.Text = tostring(opts.text or sub.Text)
				title.Position = UDim2.fromOffset(TX + 6, epic and 9 or 8)
				sub.Position = UDim2.fromOffset(TX + 6, epic and 29 or 26)
				tw(title, 0.4, { TextTransparency = 0, Position = UDim2.fromOffset(TX, epic and 9 or 8) }, Enum.EasingStyle.Quint)
				task.delay(0.06, function()
					tw(sub, 0.4, { TextTransparency = 0.05, Position = UDim2.fromOffset(TX, epic and 29 or 26) }, Enum.EasingStyle.Quint)
				end)
				sc.Scale = scale * 0.96
				tw(sc, 0.5, { Scale = scale }, Enum.EasingStyle.Back)
			end)
			timerId += 1
			local my = timerId
			entry.timed = true
			task.delay(0.18 + (opts.duration or 3.2), function() if my == timerId and close then close() end end)
		end
		entry.handle = { close = function() close() end, card = card, success = function(opts) entry.success(opts or {}) end }
		return entry.handle
	end
	getgenv().VIREX_TopBanner = VIREX_TopBanner
end

-- Aviso: "pega el balon a mano una vez" (pequeño, se queda arriba hasta el primer golpe)
do
	local G = getgenv()
