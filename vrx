	local FONT_FAMILIES = {
		Code = "rbxasset://fonts/families/RobotoMono.json", Gotham = "rbxasset://fonts/families/GothamSSm.json", Ubuntu = "rbxasset://fonts/families/Ubuntu.json",
		Arial = "rbxasset://fonts/families/Arial.json", Fredoka = "rbxasset://fonts/families/FredokaOne.json", Oswald = "rbxasset://fonts/families/Oswald.json",
		Arcade = "rbxasset://fonts/families/PressStart2P.json", Comic = "rbxasset://fonts/families/ComicNeueAngular.json",
	}
	function rt:set_font(name)
		local fam = FONT_FAMILIES[name]
		if not fam then return end
		SKIN.family = fam
		reskinAll("font")
	end
	function rt:font_names() return { "Gotham", "Arial", "Ubuntu", "Code", "Oswald", "Fredoka", "Arcade", "Comic" } end
	function rt:accent_names() return { "White", "Blue", "Red", "Purple", "Pink", "Green", "Cyan", "Gold", "Orange" } end
	function rt:set_accent(name)
		local c = ACCENTS[name]
