	local Last_FFA
	local function onScreenTargets(filter)
		local cam = workspace.CurrentCamera
		local list = {}
		local alive = workspace:FindFirstChild("Alive")
		if not alive then return list end
		for _, c in ipairs(alive:GetChildren()) do
			if c ~= Player.Character and c.PrimaryPart then
				local s, on = cam:WorldToScreenPoint(c.PrimaryPart.Position)
				if on and (not filter or filter(c)) then list[#list + 1] = { Character = c, Screen = { s.X, s.Y }, Pos = s } end
			end
		end
		return list
	end
	function E.Parry_Data(kind)
		local cam = workspace.CurrentCamera
		local sp, mouse = screenData()
		local camCF = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + cam.CFrame.LookVector)
		local my = Player.Character and Player.Character.PrimaryPart
		if kind == "Dot" and my then
			local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
			local best, bd = nil, math.huge
			for _, t in ipairs(onScreenTargets()) do
				local d = (Vector2.new(t.Pos.X, t.Pos.Y) - center).Magnitude
				if d < bd then bd, best = d, t end
			end
			if best then return CFrame.new(my.Position, best.Character.PrimaryPart.Position + Vector3.new(0, 1.75, 0)), sp, best.Screen end
		elseif kind == "Dot Pointer" and my then
			local m = UIS:GetMouseLocation()
			local dir = cam:ScreenPointToRay(m.X, m.Y).Direction
			local best, bd = nil, -math.huge
			local alive = workspace:FindFirstChild("Alive")
			for _, c in ipairs(alive and alive:GetChildren() or {}) do
				if c.Name ~= Player.Name and c.PrimaryPart then
					local d = dir:Dot((c.PrimaryPart.Position - cam.CFrame.Position).Unit)
					if d > bd then bd, best = d, c end
				end
			end
			local pos = best and best.PrimaryPart.Position or (my.Position + cam.CFrame.LookVector * 1000)
			return CFrame.lookAt(my.Position, pos + Vector3.new(0, 2, 0)), sp, mouse
		elseif kind == "Closest" and my then
			local best, bd = nil, math.huge
			for _, t in ipairs(onScreenTargets()) do
				local d = (my.Position - t.Character.PrimaryPart.Position).Magnitude
				if d < bd then bd, best = d, t end
			end
			if best then return CFrame.new(my.Position, best.Character.PrimaryPart.Position), sp, best.Screen end
		elseif kind == "FFA" and my then
			local ball = E.Get_Ball()
			local tgt = ball and ball:GetAttribute("target")
			if tgt ~= Last_FFA then Last_FFA = nil end
			local list = onScreenTargets(function(c) return c.Name ~= tgt and c.Name ~= Last_FFA end)
			if #list > 0 then
				local p = list[math.random(1, #list)]
				Last_FFA = p.Character.Name
				return CFrame.new(my.Position, p.Character.PrimaryPart.Position), sp, p.Screen
			end
		elseif kind == "High" then
			return CFrame.new(cam.CFrame.Position, cam.CFrame.Position + Vector3.new(0, 10000, 0)), sp, mouse
		elseif kind == "Backwards" then
			local n = -cam.CFrame.LookVector * 10000
			return CFrame.new(cam.CFrame.Position, cam.CFrame.Position + Vector3.new(n.X, 100, n.Z)), sp, mouse
		elseif kind == "Random" then
			return CFrame.new(cam.CFrame.Position, Vector3.new(math.random(-3000, 3000), math.random(-3000, 3000), math.random(-3000, 3000))), sp, mouse
		elseif kind ~= "Camera" then
			-- tus curvas de siempre (Accelerated, Slow, Speed, Down, Left, Right...)
			local ok, cf = pcall(function() return System.curve.get_cframe() end)
			if ok and typeof(cf) == "CFrame" then return cf, sp, mouse end
		end
		return camCF, sp, mouse
	end

