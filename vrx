			for i = 1, 5 do
				local target = on and math.clamp(0.22 + L * (0.5 + 0.5 * math.abs(math.sin(t * (4.5 + i * 1.5) + i))), 0.18, 1) or 0.2
				eqS[i] = eqS[i] + (target - eqS[i]) * math.min(dt * 12, 1)
				barsMini[i].Size = UDim2.new(0, 3, eqS[i], 0)
			end
			miniLogoSc.Scale = 1 + L * 0.08
			if full.Visible then
				for i = 1, NB do
					local n = math.noise(i * 0.23, t * 1.6, 0.37)
					local n01 = math.clamp(0.5 + n * 1.3, 0, 1)
					local shape = 0.55 + 0.45 * math.sin(math.pi * (i - 0.5) / NB)
					local target
					if on then
						target = math.clamp(0.05 + L * (0.3 + 1.0 * n01) * (0.5 + 0.6 * shape), 0.05, 1)
					else
						target = 0.05
					end
					local cur = hv[i]
					cur = cur + (target - cur) * math.min(dt * (target > cur and 18 or 6), 1)
					hv[i] = cur
					bars[i].Size = UDim2.new(1 / NB, -2, cur, 0)
				end
			end
			local len = sound.TimeLength
			local a = len > 0 and math.clamp(sound.TimePosition / len, 0, 1) or 0
			-- la linea avanza suave (no a saltos), salvo al arrastrar o al cambiar de cancion
			if seeking or math.abs(a - shownPos) > 0.05 then shownPos = a else shownPos = shownPos + (a - shownPos) * math.min(dt * 10, 1) end
			miniBar.Size = UDim2.fromScale(shownPos, 1)
			-- en movil las barritas se mueven a 24 fps (menos lag)
			if mini.GroupTransparency < 0.99 and (not isMobile or t - (island.waveT or 0) > 1 / 24) then
				island.waveT = t
				for i = 1, NW do
					local n = math.noise(i * 0.31, t * 1.4, 0.71)
					local shape = 0.45 + 0.55 * math.abs(math.sin(i * 1.7))
					local target = on and math.clamp(0.25 + L * (0.35 + 0.9 * math.clamp(0.5 + n, 0, 1)) * shape, 0.22, 1) or (0.22 + 0.25 * shape)
					waveH[i] = waveH[i] + (target - waveH[i]) * math.min(dt * 14, 1)
					local wb = waveBars[i]
					wb.Size = UDim2.new(0, 2.5, waveH[i], 0)
					local filled = (i - 0.5) / NW <= shownPos
					wb.BackgroundTransparency = filled and 0 or 0.72
				end
			end
			trackFill.Size = UDim2.fromScale(shownPos, 1)
			knob.Position = UDim2.fromScale(shownPos, 0.5)
			local left = math.max(len - sound.TimePosition, 0)
			tL.Text = fmt(sound.TimePosition)
			tR.Text = "-" .. fmt(left)
			if playIcon.Visible ~= (not on) then
				playIcon.Visible = not on
				pauseIcon.Visible = on
				if island.setMedia then pcall(island.setMedia, on) end
				local s0 = on and pauseSc or iconSc
				s0.Scale = 0.55
				tw(s0, 0.35, { Scale = 1 }, SPRING)
			end
			-- se cierra sola si no la tocas
			if island.open and not seeking and os.clock() - closeTimer > AUTO_CLOSE then setIslandOpen(false) end
		end)

		island.gui = gui
		-- cambio de cancion: el nombre sale hacia arriba y el nuevo entra desde abajo (fundido limpio)
		local titleTok = 0
		island.setTitle = function(name)
			name = tostring(name or "")
			if title.Text == "" then
				title.Text, miniTitle.Text = name, name
				return
			end
			if title.Text == name then return end
			titleTok += 1
			local my = titleTok
			tw(title, 0.16, { TextTransparency = 1, Position = UDim2.fromOffset(22, -2) }, Enum.EasingStyle.Quad)
			tw(miniTitle, 0.16, { TextTransparency = 1, Position = UDim2.fromOffset(40, -5) }, Enum.EasingStyle.Quad)
			task.delay(0.17, function()
				if my ~= titleTok then return end
				title.Text, miniTitle.Text = name, name
				title.Position = UDim2.fromOffset(22, 10)
				miniTitle.Position = UDim2.fromOffset(40, 5)
				tw(title, 0.45, { TextTransparency = 0, Position = UDim2.fromOffset(22, 4) }, SMOOTH)
				tw(miniTitle, 0.45, { TextTransparency = 0, Position = UDim2.fromOffset(40, 0) }, SMOOTH)
			end)
		end
		-- entrada: nace como un punto, se abre a pastilla y luego aparece el texto
		local visibleState = false
		island.show = function(v)
			if v then
				gui.Enabled = true
				if not visibleState then
					visibleState = true
					isl.Size = UDim2.fromOffset(MINI.Y, MINI.Y)
					isl.BackgroundTransparency = 1
					st.Transparency = 1
					logo.ImageTransparency = 1
					mini.GroupTransparency = 1
					sc.Scale = BASE * 0.6
					tw(sc, 0.5, { Scale = BASE }, SMOOTH)
					tw(isl, 0.3, { BackgroundTransparency = 0.16 }, Enum.EasingStyle.Quad)
					tw(st, 0.4, { Transparency = 0.2 }, Enum.EasingStyle.Quad)
					task.delay(0.18, function()
						if not visibleState then return end
						tw(isl, 0.7, { Size = UDim2.fromOffset(MINI.X, MINI.Y) }, SMOOTH)
						tw(logo, 0.9, { ImageTransparency = LOGO_T }, Enum.EasingStyle.Quad)
					end)
					task.delay(0.45, function()
						if not visibleState or island.open then return end
						miniTitle.Position = UDim2.fromOffset(48, 0)
						tw(mini, 0.45, { GroupTransparency = 0 }, Enum.EasingStyle.Quad)
						tw(miniTitle, 0.6, { Position = UDim2.fromOffset(40, 0) }, SMOOTH)
					end)
				end
			else
				if not visibleState then return end
				visibleState = false
				island.open = false
				openTok += 1
				full.Visible = false
				tw(mini, 0.2, { GroupTransparency = 1 }, Enum.EasingStyle.Quad)
				tw(logo, 0.2, { ImageTransparency = 1 }, Enum.EasingStyle.Quad)
				tw(isl, 0.45, { Size = UDim2.fromOffset(MINI.Y, MINI.Y) }, SMOOTH, Enum.EasingDirection.InOut)
				tw(sc, 0.5, { Scale = BASE * 0.6 }, SMOOTH, Enum.EasingDirection.In)
				tw(isl, 0.5, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
				tw(st, 0.45, { Transparency = 1 }, Enum.EasingStyle.Quad)
				task.delay(0.52, function()
					if not visibleState then
						gui.Enabled = false
						isl.Size = UDim2.fromOffset(0, MINI.Y)
						sc.Scale = BASE
						mini.GroupTransparency = 0
					end
				end)
			end
		end
		-- (sin VIREX_Skin: la isla tiene sus propios colores y no cambia con el color del UI)
		gui.Enabled = false
		gui.Parent = parent
	end
	islandSync = function()
		if not island.enabled or not M.playing then
			if island.gui and island.gui.Enabled and island.show then island.show(false) end
			return
		end
		local okB, errB = pcall(buildIsland)
		if not okB then
			warn("[VIREX Music] island error: " .. tostring(errB))
			return
		end
		island.show(true)
		local sng = SONGS[M.idx]
		island.setTitle(sng and sng.name or "Music")
	end

	-- al acabar (sin repetir): pasa a la siguiente
	sound.Ended:Connect(function()
		if M.playing and not M.loop then play(M.idx % #SONGS + 1) end
	end)
	-- boton flotante MUSIC: tocar para poner / quitar
	pcall(function()
		playBtn = VIREX_MakeActionButton({ name = "VIREX_MusicButton", label = "MUSIC", activeLabel = "PLAYING", yOffset = 250, onToggle = function(on)
			if on then play() else stop() end
			return on
		end })
