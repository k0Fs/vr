--    de todo el UI, y los primeros golpes se perdian)
do
    local hooked = 0
    local function hookOne(r)
        if r:IsA("RemoteEvent") or r:IsA("RemoteFunction") then
            local ok = pcall(_hook, r)
            if ok then hooked += 1 end
        end
    end
    pcall(function()
        for _, _remote in pairs(replicated_storage:GetDescendants()) do hookOne(_remote) end
        replicated_storage.DescendantAdded:Connect(function(r) pcall(hookOne, r) end)
    end)
    print("[VIREX] remotes enganchados: " .. hooked)
    pcall(function()
        if not (hookmetamethod and getnamecallmethod) then return end
        local wrap = newcclosure or function(f) return f end
        local oldNC
        oldNC = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            if not _ncOff and not _capturedValid and not _selfFire and select("#", ...) >= 8 then
                local m = getnamecallmethod()
                if (m == "FireServer" or m == "InvokeServer") and not (checkcaller and checkcaller()) then
                    local args = table.pack(...)
                    pcall(_tryCapture, self, args)
                end
            end
            return oldNC(self, ...)
        end))
        _ncActive = true
        _ncOld = oldNC
        -- si ya estaba capturado de antes, fuera el gancho enseguida
        if _capturedRemote then task.defer(function() _unhookIndex() _unhookNC() end) end
        print("[VIREX] namecall enganchado")
    end)
end

-- 2) token del parry: se busca UNA vez al empezar (como NAZK). Si aun no estaba, se vuelve a buscar
--    justo cuando pegas el balon (en ese momento seguro que existe) y, como respaldo, cada pocos segundos
local _tokenSearching = false
-- busca en una lista de la memoria la funcion "PRY" (repartido en frames: en movil no se congela)
local function _scanForToken(list)
    for i, Function in ipairs(list) do
        if _tokenFound then return true end
        if type(Function) == "function" then
            local okS, src = pcall(debug.info, Function, "s")
            if okS and type(src) == "string" and src:find("PRY", 1, true) then
                local okU, ups = pcall(debug.getupvalues, Function)
                if okU and type(ups) == "table" then
                    for _, value in pairs(ups) do
                        if type(value) == "function" then
                            _token = value
                            _tokenFound = true
                            return true
                        end
                    end
                end
            end
        end
        if i % 4000 == 0 then task.wait() end
    end
    return _tokenFound
end
local function _findToken()
    if _tokenFound then return true end
    if _tokenSearching then return false end
    _tokenSearching = true
    pcall(function()
        -- primero SOLO funciones (mucho mas rapido, sobre todo en movil); si no sale, la lista completa
        local okF, fns = pcall(getgc, false)
        if okF and type(fns) == "table" then _scanForToken(fns) end
        fns = nil
        if not _tokenFound then
            local okA, all = pcall(getgc, true)
            if okA and type(all) == "table" then _scanForToken(all) end
        end
    end)
    _tokenSearching = false
    return _tokenFound
end
-- en segundo plano: el script (y el panel) cargan sin esperar a esta busqueda
