	selectTab = function(name, instant)
		if currentTab == name and not instant then return end
		closeDrops()
		local old = currentTab and pages[currentTab]
		currentTab = name
		for _, t in ipairs(tabList) do paintTab(t, t.name == name, not instant) end
		pageTitle.Text = name
		if tabs[name] then spinRing.Parent = tabs[name].btn loadGlow() end
		local p = pages[name]
		if old and old ~= p then old.group.Visible = false end
		if p then
			p.group.Visible = true
			task.defer(function() pcall(rebalance, p) end)
			if not instant then
				p.group.Position = UDim2.fromOffset(SIDE + 1, TOPH + 12)
				tween(p.group, 0.28, { Position = UDim2.fromOffset(SIDE + 1, TOPH) })
			end
		end
