	function rt:link(owner, list, resettable)
		if not owner or not owner._row then return end
		local g = owner._group
		owner._links = owner._links or {}
		owner._n = owner._n or 0
		for _, hd in ipairs(list or {}) do
			if hd and hd.frame then
				owner._n += 1
				hd.frame.Parent = g.box
				hd.frame.LayoutOrder = owner._order + owner._n
				if hd.kind == "toggle" and hd._setCompact then hd:_setCompact(true) end
				hd.frame.Visible = owner._row.Visible
				table.insert(owner._links, hd)
				for _, e in ipairs(SEARCH.rows) do if e.r == hd.frame then e.g = g end end
			end
		end
		if resettable and not owner._reset then
			owner._reset = true
			owner._n += 1
			local r = new("Frame", { Parent = g.box, LayoutOrder = owner._order + 99, Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, ZIndex = 3 })
			txt(r, { Size = UDim2.new(1, -96, 1, 0), Text = "Reset to default", Font = FN, TextSize = 12.5, TextColor3 = C.sub, ZIndex = 3 })
			local b = new("TextButton", { Parent = r, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(78, 26), BackgroundColor3 = C.ctrl, AutoButtonColor = false, Text = "Reset", Font = FNB, TextSize = 12, TextColor3 = C.text, ZIndex = 5 }, { corner(7) })
			new("UIStroke", { Parent = b, Color = C.line2, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
			b.Activated:Connect(function()
				for _, hd in ipairs(owner._links or {}) do
					if hd.kind == "slider" and hd.default ~= nil then pcall(function() hd:set_value(hd.default) end) end
				end
				b.Text = "Done"
				task.delay(0.9, function() if b.Parent then b.Text = "Reset" end end)
			end)
			table.insert(owner._links, { frame = r })
		end
	end
	function rt:detach(owner, hd, separate)
		if not owner or not hd or not hd.frame then return end
		hd.frame.Visible = owner._row and owner._row.Visible or true
		if separate and hd._setCompact and hd.compact then
			-- (vuelve a ser una funcion con su tecla)
			hd.frame.LayoutOrder = owner._order + 98
		end
	end
	function rt:split(owner, hd, show)
		if not owner or not owner._row or not hd or not hd.frame then return end
		hd.frame.Parent = owner._group.box
		hd.frame.LayoutOrder = owner._order + 98
		hd.frame.Visible = show and owner._row.Visible or false
	end

