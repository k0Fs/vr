	local function setOpen(v)
		if open == v then return end
		open = v
		token += 1
		local my = token
		if v then
			refit()
			root.Visible = true
			shade.GroupTransparency = 1
			pop.Scale = 0.86
			body.Position = CENTER + UDim2.fromOffset(0, 24)
			-- abrir: crece con rebote, el velo se aclara y una linea de luz baja por el panel
			veil.Visible = true
			veil.BackgroundTransparency = 0
			scan.Visible = true
			scan.Position = UDim2.fromScale(0, 0)
			scan.BackgroundTransparency = 0.1
			tween(shade, 0.5, { GroupTransparency = 0 }, Enum.EasingStyle.Quad)
			tween(body, 0.5, { Position = CENTER }, Enum.EasingStyle.Quint)
			tween(pop, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
			tween(veil, 0.45, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			tween(scan, 0.55, { Position = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
			task.delay(0.55, function()
				if token ~= my then return end
				veil.Visible = false
				tween(scan, 0.15, { BackgroundTransparency = 1 })
				task.delay(0.16, function() if token == my then scan.Visible = false end end)
			end)
			for i, t in ipairs(tabList) do
				t.label.TextTransparency = 1
				task.delay(0.08 + i * 0.035, function() if token == my then tween(t.label, 0.3, { TextTransparency = 0 }) end end)
			end
			local mobileBlur = UIS.TouchEnabled and not UIS.MouseEnabled
			task.delay(0.3, function() if token == my and open and blur and not mobileBlur then blur.Enabled = not getgenv().VIREX_BlurOff blur.Size = getgenv().VIREX_BlurOff and 0 or 14 end end)
			for _, pg in pairs(pages) do task.defer(function() pcall(rebalance, pg) end) end
		else
			closeDrops()
			-- cerrar: se oscurece, se encoge y baja
			veil.Visible = true
