		box.MouseLeave:Connect(function() tween(bst, 0.3, { Color = C.line }) end)
		new("UIPadding", { Parent = box, PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 12) })
		new("UIListLayout", { Parent = box, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0) })
