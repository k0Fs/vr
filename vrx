		local d = G:create_dropdown("VIREX_ParryVisualizerColor", { title = "Color", options = { "Red", "Purple", "Blue", "Green", "White" }, default = "Red", callback = function(v) V.color = v end })
		UI:link(t, { d }, true)
	end)
