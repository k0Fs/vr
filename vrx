	-- ===== proteccion contra lag: picos de ping y bajadas de FPS =====
	local pingHist, lastDt, dtPeak = {}, 1 / 60, 1 / 60
	conns.lagDt = RunS.Heartbeat:Connect(function(dt)
		lastDt = math.min(dt, 0.2)
		-- el peor frame reciente (baja despacio): con tirones de FPS el balon avanza mucho entre frame y frame
