	local SHADER_NAMES = { "Default", "Morning", "Midday", "Afternoon", "Evening", "Night", "Midnight", "Sunny", "Cloudy", "Rain", "Storm", "Fog", "Snow", "Spring", "Summer", "Autumn", "Winter", "Black", "Gray", "White", "Red", "Yellow", "Green", "Pink", "Purple" }
	local SH = { name = "Default", blur = false, clouds = true }
	local LPROPS = { "Ambient", "ClockTime", "GeographicLatitude", "Brightness", "ColorShift_Bottom", "ColorShift_Top", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "GlobalShadows", "OutdoorAmbient", "ExposureCompensation", "FogEnd", "FogStart" }
	local saved, hiddenAtm, offFx = nil, {}, {}
	local fx = {}
	local myClouds, cloudBackup
	local function own(class, name)
		local o = fx[name]
		if not o or o.Parent ~= Lighting then
			o = Instance.new(class)
			o.Name = name
			o.Parent = Lighting
			fx[name] = o
		end
		return o
	end
	local function kill(name)
		if fx[name] then pcall(function() fx[name]:Destroy() end) fx[name] = nil end
	end
	local function apply()
		local p = SHADERS[SH.name]
		if not p then return end
		if not saved then
			saved = {}
			for _, k in ipairs(LPROPS) do pcall(function() saved[k] = Lighting[k] end) end
		end
		-- los efectos del juego se apagan (los nuestros los cambian) y la atmosfera del juego se guarda aparte
		for _, c in ipairs(Lighting:GetChildren()) do
			if c.Name:sub(1, 6) ~= "VIREX_" then
				if c:IsA("Atmosphere") then
					table.insert(hiddenAtm, c)
					pcall(function() c.Parent = nil end)
				elseif (c:IsA("BloomEffect") or c:IsA("ColorCorrectionEffect") or c:IsA("BlurEffect") or c:IsA("SunRaysEffect")) and c.Enabled then
					offFx[c] = true
					pcall(function() c.Enabled = false end)
				end
			end
		end
		-- solo se cambia lo que sea distinto (cambiar la luz cada segundo daba tirones)
		local function setIf(o, k, val)
			local cur = o[k]
			if type(val) == "number" and type(cur) == "number" then
				if math.abs(cur - val) < 0.01 then return end
			elseif cur == val then
				return
			end
			o[k] = val
		end
		pcall(function()
			setIf(Lighting, "Ambient", p.amb)
			setIf(Lighting, "ClockTime", p.clock)
			setIf(Lighting, "GeographicLatitude", p.lat)
			setIf(Lighting, "Brightness", math.max(p.bri, 0))
			setIf(Lighting, "ColorShift_Bottom", p.csB)
			setIf(Lighting, "ColorShift_Top", p.csT)
			setIf(Lighting, "EnvironmentDiffuseScale", math.clamp(p.envD, 0, 1))
			setIf(Lighting, "EnvironmentSpecularScale", math.clamp(p.envS, 0, 1))
			setIf(Lighting, "GlobalShadows", p.sh)
			setIf(Lighting, "OutdoorAmbient", p.oAmb)
			setIf(Lighting, "ExposureCompensation", math.clamp(p.exp, -3, 3))
			if not getgenv().VIREX_FogOn then
				setIf(Lighting, "FogStart", 0)
				setIf(Lighting, "FogEnd", 100000)
			end
		end)
		pcall(function()
			local cc = own("ColorCorrectionEffect", "VIREX_ShaderCC")
			setIf(cc, "Brightness", p.ccB) setIf(cc, "Contrast", p.ccC) setIf(cc, "Saturation", p.ccS) setIf(cc, "TintColor", p.ccT)
			local bl = own("BloomEffect", "VIREX_ShaderBloom")
			setIf(bl, "Intensity", math.clamp(p.blI, 0, 1)) setIf(bl, "Size", math.clamp(p.blS, 0, 56)) setIf(bl, "Threshold", math.clamp(p.blT, 0.8, 4))
		end)
		if SH.blur then
			pcall(function() setIf(own("BlurEffect", "VIREX_ShaderBlur"), "Size", math.clamp(p.blur * 0.5, 0, 6)) end)
		else
			kill("VIREX_ShaderBlur")
		end
		if getgenv().VIREX_FogOn then
			kill("VIREX_ShaderAtm") -- la niebla de colores manda
		else
			pcall(function()
				local a = own("Atmosphere", "VIREX_ShaderAtm")
				setIf(a, "Density", math.clamp(p.aDen, 0, 0.6)) setIf(a, "Offset", math.clamp(p.aOff, 0, 1))
				setIf(a, "Color", p.aCol) setIf(a, "Decay", p.aDec)
				setIf(a, "Glare", math.clamp(p.aGl, 0, 10)) setIf(a, "Haze", math.clamp(p.aHz, 0, 10))
			end)
		end
		if SH.clouds then
			pcall(function()
				local t = workspace:FindFirstChildOfClass("Terrain")
				if not t then return end
				local cl = t:FindFirstChildOfClass("Clouds")
				if not cl then
					cl = Instance.new("Clouds")
					cl.Name = "VIREX_Clouds"
					cl.Parent = t
					myClouds = cl
				elseif cl ~= myClouds and not cloudBackup then
					cloudBackup = { cl, cl.Cover, cl.Density, cl.Color, cl.Enabled }
				end
				setIf(cl, "Enabled", true)
				setIf(cl, "Cover", math.clamp(p.cCov, 0, 1))
				setIf(cl, "Density", math.clamp(p.cDen, 0, 1))
				setIf(cl, "Color", p.cCol)
			end)
		end
	end
	local function restoreClouds()
		if myClouds then pcall(function() myClouds:Destroy() end) myClouds = nil end
		if cloudBackup then
			pcall(function()
				local cl = cloudBackup[1]
				cl.Cover, cl.Density, cl.Color, cl.Enabled = cloudBackup[2], cloudBackup[3], cloudBackup[4], cloudBackup[5]
			end)
			cloudBackup = nil
		end
	end
	local function restore()
		for _, n in ipairs({ "VIREX_ShaderCC", "VIREX_ShaderBloom", "VIREX_ShaderBlur", "VIREX_ShaderAtm" }) do kill(n) end
		for c in pairs(offFx) do pcall(function() c.Enabled = true end) end
		offFx = {}
		for _, a in ipairs(hiddenAtm) do pcall(function() a.Parent = Lighting end) end
		hiddenAtm = {}
		restoreClouds()
		if saved then
			for k, v in pairs(saved) do pcall(function() Lighting[k] = v end) end
			saved = nil
		end
	end
	-- el juego cambia la luz entre rondas: se vuelve a poner cada segundo
	task.spawn(function()
		while true do
			task.wait(1)
			if SH.name ~= "Default" then pcall(apply) end
		end
	end)
	pcall(function() table.insert(getgenv().VIREX_UnloadHooks, function() SH.name = "Default" pcall(restore) pcall(restoreClouds) end) end)
	local G = VisualTab:create_group("Shaders", "left")
	local sd = G:create_dropdown("VIREX_Shader", { title = "Shader", description = "Light, sky and colors of the world", options = SHADER_NAMES, default = "Default", callback = function(v)
		SH.name = v
		if v == "Default" then pcall(restore) else pcall(apply) end
	end })
	local sc = G:create_toggle("VIREX_Shader_Clouds", { title = "Clouds", description = "Moving 3D clouds in the sky", default = true, callback = function(v)
		SH.clouds = v
		if not v then pcall(restoreClouds) elseif SH.name ~= "Default" then pcall(apply) end
	end })
	local sb = G:create_toggle("VIREX_Shader_Blur", { title = "Soft Blur", description = "Dreamy blur (harder to see the ball)", default = false, callback = function(v)
		SH.blur = v
		if SH.name ~= "Default" then pcall(apply) end
	end })
	local _ = { sd, sc, sb }
	pcall(function() G.box.LayoutOrder = -1 end) -- arriba del todo en Visual
end

