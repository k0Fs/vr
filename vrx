-- FAST UI START: perform the heavy remote token scan after the panel is created.
-- This also avoids aborting the entire UI when the token is temporarily unavailable.

  
function _tokenize(_remote_uid)  
    local time = tostring(math.floor(workspace:GetServerTimeNow() * 100))  
    local key = _token(_remote_uid, 'TIME')  
    local characters = table.create(#time)  
    for index = 1, #time do  
        characters[index] = string.char(bit32.bxor(  
            (string.byte(time, index ) + index) % 256,  
            string.byte(key, (index - 1) % #key + 1)  
        ))  
    end  
    return table.concat(characters)  
end  
  
local _reverted = {}  
local _original = {}  
local _captured = nil  
local _capturedRemote = nil  
local _capturedArgs = nil  
local _looseHits = {}
local _capturedLoose = false -- true si lo capturado no tenia la firma comprobada (se cambia por una buena)
local _selfFire = false -- true mientras el propio script dispara el parry (no se captura a si mismo)
-- cuando pulsas para pegar (clic, F o toque), la llamada que manda el juego justo despues es el parry
local _lastParryInput = 0
pcall(function()
    UserInputService.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
            or (t == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.F)
            or input.KeyCode == Enum.KeyCode.ButtonR1 or input.KeyCode == Enum.KeyCode.ButtonX then
            _lastParryInput = os.clock()
        end
    end)
end)
  
function _is_valid(args)  
    -- 8+ datos como el source original, y ademas la firma del parry:
    -- el dato 3 es el token que el juego calcula con el dato 2 (el mismo que usa el script al disparar).
    -- Asi no se queda con otra llamada y basta con el primer golpe.
    if not args or #args < 8 then return false end  
    if not _token then return false end -- sin token aun: solo vale la llamada justo despues de tu golpe
    if type(args[3]) == "string" and (type(args[2]) == "string" or type(args[2]) == "number") and _token then
        local ok, expected = pcall(_tokenize, args[2])
        if ok and type(expected) == "string" then
            local n = math.min(#expected, #args[3]) - 3
            if n >= 4 then
                return expected:sub(1, n) == args[3]:sub(1, n)
            end
        end
    elseif type(args[3]) ~= "string" then
        return false -- el parry siempre lleva el token (texto) en el dato 3
    end
    return true  
end  
  
-- decide si una llamada es el parry: firma comprobada con el token, o justo despues de que pegas tu
local _capturedValid = false
local _hookMeta, _hookOld, _ncActive, _indexOff = nil, nil, false, false
local _ncOld, _ncOff = nil, false
-- quita el gancho __namecall (pasaba por CADA llamada del juego: mucho lag). Se pone el original otra vez
local function _unhookNC()
    if _ncOff or not _ncOld or not hookmetamethod then return end
    local ok = pcall(hookmetamethod, game, "__namecall", _ncOld)
    if ok then _ncOff = true print("[VIREX] gancho __namecall quitado (sin lag)") end
end
-- quita el gancho __index (se usa solo hasta capturar; despues solo hacia lag, sobre todo en movil)
local function _unhookIndex()
    if _indexOff or not (_hookMeta and _hookOld and _ncActive) then return end
    local ok = pcall(function()
        setreadonly(_hookMeta, false)
        _hookMeta.__index = _hookOld
        setreadonly(_hookMeta, true)
    end)
    if ok then _indexOff = true print("[VIREX] gancho __index quitado (menos lag)") end
end
local function _tryCapture(remote, args)
    if typeof(remote) ~= "Instance" or type(args) ~= "table" or (args.n or #args) < 8 then return end
    local valid = false
    pcall(function() valid = _is_valid(args) end)
    -- forma del parry: dato 5 = CFrame (camara), 6 = tabla de jugadores, 7 = tabla (punto de la pantalla)
    local shape = typeof(args[5]) == "CFrame" and type(args[6]) == "table" and type(args[7]) == "table"
    if not shape then return end -- otra llamada del juego con 8 datos: NO es el parry
    local recent = os.clock() - _lastParryInput < 0.6
    if not valid and not recent then return end
    if _capturedRemote and _capturedValid and not valid then return end -- ya hay uno bueno: no se cambia
    local first = _capturedRemote == nil
    local changed = _capturedRemote ~= nil and _capturedRemote ~= remote
    _captured = { remote = remote, args = args }
    _capturedRemote = remote
    _capturedArgs = args
    _capturedValid = valid
    _capturedLoose = not valid
    if not _tokenFound and getgenv().VIREX_FindTokenNow then pcall(getgenv().VIREX_FindTokenNow) end
    task.defer(function() _unhookIndex() _unhookNC() end)
    if first or changed then
        pcall(function() print("[VIREX] parry capturado: " .. tostring(remote.Name) .. (valid and " (firma ok)" or " (por tu golpe)") .. (changed and " [cambiado]" or "")) end)
    end
end

function _hook(remote)  
    if not remote then return end  
    if _reverted[remote] then return end  
    if _original[getrawmetatable(remote)] then return end  
  
    _original[getrawmetatable(remote)] = true  
    local _meta = getrawmetatable(remote)  
    setreadonly(_meta, false)  
  
    local _old = _meta.__index  
    _meta.__index = function(self, key)  
        if (key == 'FireServer' and self:IsA('RemoteEvent')) or  
           (key == 'InvokeServer' and self:IsA('RemoteFunction')) then  
            return function(_, ...)  
                local _arguments = table.pack(...)
                local _n = _arguments.n
                -- DETECTOR COPIADO DEL SOURCE NAZK: cada remote, en su PRIMERA llamada con 8+ datos,
                -- pasa a ser el capturado. Si antes se cogio otro remote por error (uno del juego que
                -- tambien manda 8+ datos), el remote del parry lo sustituye en cuanto pulsas para pegar.
                -- (antes el primero se quedaba fijo y por eso habia que pegar muchas veces)
                if _n >= 8 and not _selfFire then pcall(_tryCapture, self, _arguments) end
                return _old(self, key)(_, unpack(_arguments, 1, _n))  
            end  
        end  
        return _old(self, key)  
    end  
    _hookMeta, _hookOld = _meta, _old
    setreadonly(_meta, true)  
end  
  
