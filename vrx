	pcall(function()
		local G = WorldTab:create_group("Performance", "left")
		local P = { cap = false, capv = 60, al = false, alfps = 35, boosted = false }
		local function applyCap()
			if not setfpscap then return end
			pcall(setfpscap, P.cap and P.capv or 0)
		end
		local t = G:create_toggle("VIREX_FPSCap", { title = "FPS Cap", description = "Limits FPS (if your device gets hot)", default = false, callback = function(v) P.cap = v applyCap() end })
		local s = G:create_slider("VIREX_FPSCapValue", { title = "Max FPS", minimum = 30, maximum = 360, default = 60, rounding = true, callback = function(v) P.capv = v if P.cap then applyCap() end end })
		UI:link(t, { s }, true)
		-- anti lag: si los FPS bajan mucho, se activa solo el FPS Booster
		local frames, acc = 0, 0
		conns.antilag = RunS.Heartbeat:Connect(function(dt)
			if not P.al then return end
			frames += 1
			acc += dt
			if acc < 2 then return end
			local fps = frames / acc
			frames, acc = 0, 0
			if fps < P.alfps and not P.boosted then
				P.boosted = true
				pcall(function() local m = UI._byFlag and UI._byFlag["VIREX_FPSBooster"] if m and not m:get_value() then m:set_value(true) end end)
				note("Anti Lag", ("FPS were %d: FPS Booster on"):format(math.floor(fps)))
			end
		end)
		local t2 = G:create_toggle("VIREX_AntiLag", { title = "Anti Lag", description = "Turns on FPS Booster by itself if FPS drop", default = false, callback = function(v) P.al = v end })
		local s2 = G:create_slider("VIREX_AntiLagFPS", { title = "When FPS under", minimum = 15, maximum = 60, default = 35, rounding = true, callback = function(v) P.alfps = v end })
		UI:link(t2, { s2 }, true)
	end)

	-- ----- Server: rejoin, cambiar de server, reset, anti AFK, rematch, staff -----
	pcall(function()
		local G = WorldTab:create_group("Server", "right")
		local TS = game:GetService("TeleportService")
		local function hop()
			local ok, body = pcall(function() return game:HttpGet(("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100"):format(game.PlaceId)) end)
			if ok then
				local okj, data = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
				if okj and type(data) == "table" and type(data.data) == "table" then
					local list = {}
					for _, s in ipairs(data.data) do
						if s.id ~= game.JobId and (s.playing or 0) < (s.maxPlayers or 0) then list[#list + 1] = s.id end
					end
					if #list > 0 then
						note("Server Hop", "Joining another server...", true)
						pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, list[math.random(1, #list)], LP) end)
						return
					end
				end
			end
			note("Server Hop", "No other server found, joining a new one")
			pcall(function() TS:Teleport(game.PlaceId, LP) end)
		end
		GV.VIREX_ServerHop = hop
		G:create_button(nil, { title = "Rejoin", description = "Joins this same server again", button_text = "Rejoin", callback = function()
			pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end)
		end })
		G:create_button(nil, { title = "Server Hop", description = "Goes to another server", button_text = "Hop", callback = hop })
		G:create_button(nil, { title = "Reset Character", button_text = "Reset", callback = function()
			local h = hum()
			if h then h.Health = 0 end
		end })
		-- anti AFK
		local afkOn = false
		pcall(function()
			conns.afk = LP.Idled:Connect(function()
				if not afkOn then return end
				pcall(function()
					local VU = game:GetService("VirtualUser")
					VU:CaptureController()
					VU:ClickButton2(Vector2.new())
				end)
			end)
		end)
		G:create_toggle("VIREX_AntiAFK", { title = "Anti AFK", description = "Roblox won't kick you for being idle", default = true, callback = function(v) afkOn = v end })
		-- auto rematch (duelos)
		local rm = { on = false, last = 0 }
		local function tryRematch()
			if not rm.on or tick() - rm.last < 1.5 then return end
			local pg = LP:FindFirstChild("PlayerGui")
			if not pg then return end
			for _, b in ipairs(pg:GetDescendants()) do
				if b:IsA("GuiButton") and (b.Name == "RematchButton" or b.Name == "PlayAgain") and b.Visible and b.AbsoluteSize.X > 0 then
					if b.Name == "RematchButton" then
						local r = netRemote("PlayerWantsRematch")
						if r and r:IsA("RemoteEvent") then rm.last = tick() r:FireServer() return end
					else
						local r = netRemote("SetDuelAutoQueue")
						if r and r:IsA("RemoteEvent") then
							local n = 2
							pcall(function() n = math.clamp(math.ceil((tonumber(RS.ServerInfo.numPlayers.Value) or 2) / 2), 1, 4) end)
							rm.last = tick()
							r:FireServer("Duel", n .. "v" .. n)
							return
						end
					end
				end
			end
		end
		local accR = 0
		conns.rematch = RunS.Heartbeat:Connect(function(dt) accR += dt if accR < 0.5 then return end accR = 0 if rm.on then pcall(tryRematch) end end)
		G:create_toggle("VIREX_AutoRematch", { title = "Auto Rematch", description = "Presses Rematch / Play Again when a duel ends", default = false, callback = function(v) rm.on = v end })
	end)

	-- ----- Staff Detection -----
	pcall(function()
		local G = WorldTab:create_group("Staff Detection", "left")
		local S = { on = true, action = "Notification" }
		local function check(p)
			if not S.on or p == LP then return end
			task.spawn(function()
				local role = ""
				pcall(function() role = tostring(p:GetRoleInGroup(12836673)):lower() end)
				if role == "guest" or role == "member" or role == "" then return end
				local msg = "Staff joined: " .. p.DisplayName .. " (" .. role .. ")"
				if S.action == "Leave Game" then
					LP:Kick(msg)
				elseif S.action == "Server Hop" then
					note("Staff Detection", msg .. ". Hopping...")
					pcall(function() GV.VIREX_ServerHop() end)
				else
					note("Staff Detection", msg)
					pcall(function() GV.VIREX_TopBanner({ title = "STAFF", text = msg, width = 300, duration = 6 }) end)
				end
			end)
		end
		conns.staff = Players.PlayerAdded:Connect(check)
		G:create_toggle("VIREX_StaffDetect", { title = "Staff Detection", description = "Warns you when Blade Ball staff join", default = true, callback = function(v)
			S.on = v
			if v then for _, p in ipairs(Players:GetPlayers()) do check(p) end end
