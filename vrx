		local LOW = Color3.fromRGB(5, 5, 7)
		local DEEP = Color3.fromRGB(150, 16, 30)
		local SOFT = Color3.fromRGB(236, 206, 210)
		local function tw(o, t, props, style, dir)
			local x = TS:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
			x:Play()
			return x
		end
		local function mk(class, props)
			local o = Instance.new(class)
			for k, val in pairs(props) do
				if k ~= "Parent" then o[k] = val end
			end
			o.Parent = props.Parent
			return o
		end
		local function round(o, r)
			local c = Instance.new("UICorner")
			c.CornerRadius = r or UDim.new(1, 0)
			c.Parent = o
			return c
		end
		local function NS(...)
			local kp = {}
			for _, p in ipairs({ ... }) do kp[#kp + 1] = NumberSequenceKeypoint.new(p[1], p[2]) end
			return NumberSequence.new(kp)
		end
		local function CS(...)
			local cs = { ... }
			if #cs == 2 then return ColorSequence.new(cs[1], cs[2]) end
			local kp = {}
			for i, c in ipairs(cs) do kp[i] = ColorSequenceKeypoint.new((i - 1) / (#cs - 1), c) end
			return ColorSequence.new(kp)
		end
		local function grad(parent, props)
			local g = Instance.new("UIGradient")
			for k, v in pairs(props) do g[k] = v end
			g.Parent = parent
