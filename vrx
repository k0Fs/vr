		local COL = { Red = Color3.fromRGB(255, 60, 75), Purple = Color3.fromRGB(125, 85, 255), Blue = Color3.fromRGB(60, 140, 255), Green = Color3.fromRGB(60, 220, 120), White = Color3.fromRGB(245, 245, 250) }
		local ring
		local function stop() disc("viz") pcall(function() ring:Destroy() end) ring = nil end
		local function start()
			stop()
			ring = Instance.new("Part")
			ring.Name = "VIREX_ParryRange"
			ring.Shape = Enum.PartType.Cylinder
			ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch, ring.CastShadow = true, false, false, false, false
			ring.Material = Enum.Material.ForceField
			ring.Transparency = 0.15
			ring.Parent = workspace.CurrentCamera
			conns.viz = RunS.RenderStepped:Connect(function()
				local r = hrp()
				if not r or not ring then return end
				local reach = 15
				pcall(function()
					local E = GV.VIREX_Engine
					local ball = E and E.Get_Ball and E.Get_Ball()
					local z = ball and ball:FindFirstChild("zoomies")
					local speed = z and z.VectorVelocity.Magnitude or 0
					local ping = E and E.Get_Ping and E.Get_Ping() or 60
					reach = math.clamp(ping / 10, 10, 16) + speed / (2.3497562749127492 + math.clamp(speed, 0, 425) * 0.002) * ((E and E.SDM) or 1.1) + ((E and E.flags and E.flags.Parry_Range) or 0)
				end)
