-- ===== Botones flotantes (SPAM, TRIGGER): pequeños, rojos, estilo del panel, se pueden mover =====
local function VIREX_MakeActionButton(cfg)
	-- cfg = { name, label, activeLabel, yOffset, onToggle(on) -> bool (estado final) }
	local TS = game:GetService("TweenService")
	local UIS2 = game:GetService("UserInputService")
	local function tw(o, t, props, style, dir, rep, rev)
		local x = TS:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out, rep or 0, rev or false), props)
		x:Play()
		return x
	end
	local RED = Color3.fromRGB(45, 125, 255)
	local gui, active, savedPos = nil, false, nil
	local api = {}
	local paint -- (pinta el boton segun el estado)

	function api.set(on)
		active = on and true or false
		if paint then paint() end
	end
	-- lo mismo que tocar el boton (para la tecla); solo si el boton esta en pantalla
	function api.press()
		if not gui then return end
		local want = not active
		local res = cfg.onToggle(want)
		active = (res == nil) and want or (res and true or false)
		if paint then paint() end
	end
	function api.show(show, startOn)
		if not show then
			if active then pcall(cfg.onToggle, false) active = false end
			if gui then
				local g = gui
				gui = nil
				paint = nil
				pcall(function()
					local b = g:FindFirstChild("Btn", true)
					local s = b and b:FindFirstChildOfClass("UIScale")
					if s then tw(s, 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In) end
				end)
				task.delay(0.32, function() pcall(function() g:Destroy() end) end)
			end
			return
		end
		if gui then return end
		local parent
		pcall(function() if gethui then parent = gethui() end end)
		if not parent then parent = CoreGui end
		local old = parent:FindFirstChild(cfg.name)
		if old then old:Destroy() end
		gui = Instance.new("ScreenGui")
		gui.Name = cfg.name
		-- (sin VIREX_Skin: colores fijos, no cambian con el color del UI)
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 120
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
		gui.Parent = parent

		local inset = 10
		pcall(function() inset = game:GetService("GuiService"):GetGuiInset().Y + (cfg.yOffset or 70) end)
		local btn = Instance.new("TextButton")
		btn.Name = "Btn"
		btn.AnchorPoint = Vector2.new(0.5, 0)
		btn.Position = savedPos or UDim2.new(0.5, 0, 0, inset)
		btn.Size = UDim2.fromOffset(128, 40)
		btn.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
		btn.AutoButtonColor = false
		btn.Text = ""
		btn.Parent = gui
		-- cristal liquido con toque rojo (sin pulsos)
		-- cristal liquido de 2 colores: apagado = rojo y negro, encendido = verde y negro
		local SP_RED, SP_RED_HI = Color3.fromRGB(118, 118, 130), Color3.fromRGB(170, 170, 182)
		local SP_GRN, SP_GRN_HI = Color3.fromRGB(240, 240, 246), Color3.fromRGB(255, 255, 255)
		local glass = {}
		do
			local W1 = Color3.new(1, 1, 1)
			local function NSq(...) local k = {} for _, p in ipairs({ ... }) do k[#k + 1] = NumberSequenceKeypoint.new(p[1], p[2]) end return NumberSequence.new(k) end
			btn.BackgroundTransparency = 1
			btn.BorderSizePixel = 0
			local bc = Instance.new("UICorner") bc.CornerRadius = UDim.new(1, 0) bc.Parent = btn
			local function lay(color, z)
				local f = Instance.new("Frame")
				f.Size = UDim2.fromScale(1, 1)
				f.BackgroundColor3 = color
				f.BorderSizePixel = 0
				f.ZIndex = z or 1
				f.Parent = btn
				local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1, 0) c.Parent = f
				return f
			end
			-- fondo: dos capas (roja y verde) que se cruzan suave al encender
			local bgOff = lay(W1)
			local g1 = Instance.new("UIGradient") g1.Rotation = 90
			g1.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(26, 26, 31)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(12, 12, 15)), ColorSequenceKeypoint.new(1, Color3.fromRGB(6, 6, 8)) })
			g1.Parent = bgOff
			bgOff.BackgroundTransparency = 0.06
			local bgOn = lay(W1)
			local g2 = Instance.new("UIGradient") g2.Rotation = 90
			g2.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(52, 52, 60)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(24, 24, 29)), ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 10, 12)) })
			g2.Parent = bgOn
			bgOn.BackgroundTransparency = 1
			-- toque de color en diagonal y luz que sube desde abajo
			local tint = lay(SP_RED)
			local tg = Instance.new("UIGradient") tg.Rotation = 18 tg.Transparency = NSq({ 0, 0.55 }, { 0.45, 0.88 }, { 1, 0.97 }) tg.Parent = tint
			local under = lay(SP_RED)
			local ug = Instance.new("UIGradient") ug.Rotation = -90 ug.Transparency = NSq({ 0, 0.62 }, { 0.4, 0.94 }, { 1, 1 }) ug.Parent = under
			-- reflejo de cristal arriba y linea de luz
			local gl = lay(W1)
			local gg = Instance.new("UIGradient") gg.Rotation = 90 gg.Transparency = NSq({ 0, 0.66 }, { 0.45, 0.94 }, { 1, 1 }) gg.Parent = gl
			local rim = Instance.new("Frame")
			rim.AnchorPoint = Vector2.new(0.5, 0)
			rim.Position = UDim2.new(0.5, 0, 0, 1)
			rim.Size = UDim2.new(1, -36, 0, 1)
			rim.BackgroundColor3 = W1
			rim.BorderSizePixel = 0
			rim.Parent = btn
			local rg = Instance.new("UIGradient") rg.Transparency = NSq({ 0, 1 }, { 0.5, 0.05 }, { 1, 1 }) rg.Parent = rim
			-- borde: blanco arriba -> color abajo
			local st = Instance.new("UIStroke")
			st.Color = SP_RED
			st.Thickness = 1.3
			st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			st.Parent = btn
			local sg = Instance.new("UIGradient") sg.Rotation = 90
			sg.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, W1), ColorSequenceKeypoint.new(0.45, Color3.fromRGB(150, 150, 160)), ColorSequenceKeypoint.new(1, W1) })
			sg.Transparency = NSq({ 0, 0 }, { 0.5, 0.55 }, { 1, 0.1 })
			sg.Parent = st
			-- modo arcoiris: el color del cristal, la luz de abajo y el borde van cambiando por todos los colores
			if cfg.rainbow then
				local RBs = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 90)), ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 160, 50)),
					ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 70)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 230, 120)),
					ColorSequenceKeypoint.new(0.67, Color3.fromRGB(60, 200, 255)), ColorSequenceKeypoint.new(0.83, Color3.fromRGB(130, 100, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 200)) })
				sg.Color = RBs
				sg.Rotation = 0
				sg.Transparency = NSq({ 0, 0 }, { 1, 0 })
				st.Color = W1
				g1.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 40, 52)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(14, 14, 18)), ColorSequenceKeypoint.new(1, Color3.fromRGB(5, 5, 6)) })
				g2.Color = g1.Color
				local rbOn = false
				local rbConn
				rbConn = game:GetService("RunService").RenderStepped:Connect(function(dt)
					if not btn.Parent then rbConn:Disconnect() return end
					local hue = (os.clock() * (rbOn and 0.45 or 0.12)) % 1
					local c = Color3.fromHSV(hue, 0.75, 1)
					tint.BackgroundColor3 = c
					under.BackgroundColor3 = c
					sg.Rotation = (sg.Rotation + dt * (rbOn and 240 or 70)) % 360
					pcall(function() if btn:FindFirstChild("Dot") then btn.Dot.BackgroundColor3 = c end end)
					pcall(function() if btn:FindFirstChild("Halo") then btn.Halo.BackgroundColor3 = c end end)
				end)
				-- brillo que da vueltas por el borde (como el Apply dorado, pero arcoiris)
				local spin = Instance.new("Frame")
				spin.Name = "VX_RainbowSpin"
				spin.Size = UDim2.fromScale(1, 1)
				spin.BackgroundTransparency = 1
				spin.ZIndex = 4
				spin.Parent = btn
				local spc = Instance.new("UICorner") spc.CornerRadius = UDim.new(1, 0) spc.Parent = spin
				local sps = Instance.new("UIStroke") sps.Color = W1 sps.Thickness = 2.2 sps.ApplyStrokeMode = Enum.ApplyStrokeMode.Border sps.Parent = spin
				local spg = Instance.new("UIGradient")
				spg.Transparency = NSq({ 0, 1 }, { 0.34, 1 }, { 0.46, 0.2 }, { 0.5, 0 }, { 0.54, 0.2 }, { 0.66, 1 }, { 1, 1 })
				spg.Parent = sps
				local spConn
				spConn = game:GetService("RunService").RenderStepped:Connect(function(dt)
					if not spin.Parent then spConn:Disconnect() return end
					spg.Rotation = (spg.Rotation + dt * (rbOn and 260 or 150)) % 360
					local h0 = os.clock() * 0.6
					spg.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromHSV(h0 % 1, 0.7, 1)), ColorSequenceKeypoint.new(0.5, Color3.fromHSV((h0 + 0.33) % 1, 0.5, 1)), ColorSequenceKeypoint.new(1, Color3.fromHSV((h0 + 0.66) % 1, 0.7, 1)) })
				end)
				glass.setRainbowOn = function(v) rbOn = v end
			end
			function glass.setActive(on)
				if glass.setRainbowOn then glass.setRainbowOn(on) tw(bgOn, 0.4, { BackgroundTransparency = on and 0.06 or 1 }, Enum.EasingStyle.Quint) tw(bgOff, 0.4, { BackgroundTransparency = on and 1 or 0.06 }, Enum.EasingStyle.Quint) tw(st, 0.4, { Thickness = on and 2 or 1.5 }, Enum.EasingStyle.Quint) return end
				local c = on and SP_GRN or SP_RED
				tw(bgOn, 0.4, { BackgroundTransparency = on and 0.06 or 1 }, Enum.EasingStyle.Quint)
				tw(bgOff, 0.4, { BackgroundTransparency = on and 1 or 0.06 }, Enum.EasingStyle.Quint)
				tw(tint, 0.4, { BackgroundColor3 = c }, Enum.EasingStyle.Quint)
				tw(under, 0.4, { BackgroundColor3 = c }, Enum.EasingStyle.Quint)
				tw(st, 0.4, { Color = c, Thickness = on and 1.7 or 1.3 }, Enum.EasingStyle.Quint)
			end
			function glass.sheen() end
		end
		local v = gui.AbsoluteSize
		local base = (v.Y > 10) and math.clamp(math.min(v.X / 1280, v.Y / 820), 0.85, 1.6) or 1
		local bsc = Instance.new("UIScale") bsc.Scale = 0 bsc.Parent = btn
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0, 0.5)
		dot.Position = UDim2.new(0, 14, 0.5, 0)
		dot.Size = UDim2.fromOffset(8, 8)
		dot.Name = "Dot"
		dot.BackgroundColor3 = SP_RED
		dot.BorderSizePixel = 0
		dot.ZIndex = 2
		dot.Parent = btn
		local dc = Instance.new("UICorner") dc.CornerRadius = UDim.new(1, 0) dc.Parent = dot
		dot.ZIndex = 3
		local halo = Instance.new("Frame")
		halo.AnchorPoint = Vector2.new(0.5, 0.5)
		halo.Position = UDim2.new(0, 18, 0.5, 0)
		halo.Size = UDim2.fromOffset(8, 8)
		halo.Name = "Halo"
		halo.BackgroundColor3 = SP_GRN
		halo.BackgroundTransparency = 1
		halo.BorderSizePixel = 0
		halo.ZIndex = 2
		halo.Parent = btn
		local hc = Instance.new("UICorner") hc.CornerRadius = UDim.new(1, 0) hc.Parent = halo
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Position = UDim2.fromOffset(16, 0)
		label.Size = UDim2.new(1, -24, 1, 0)
		label.Font = Enum.Font.GothamBlack
		label.Text = cfg.label
		label.TextSize = 14
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.ZIndex = 3
		label.Parent = btn

		local function S(x) return x * base end
		do
			local p0 = btn.Position
			btn.Position = p0 + UDim2.fromOffset(0, -40)
			btn.Rotation = -12
			tw(btn, 0.6, { Position = p0 }, Enum.EasingStyle.Quint)
			tw(btn, 0.75, { Rotation = 0 }, Enum.EasingStyle.Back)
		end
		tw(bsc, 0.6, { Scale = S(1) }, Enum.EasingStyle.Back)
		task.delay(0.25, function() if btn.Parent then glass.sheen() end end)
		local function bump(x)
			bsc.Scale = S(x)
			tw(bsc, 0.45, { Scale = S(1) }, Enum.EasingStyle.Back)
		end
		paint = function()
			label.Text = active and cfg.activeLabel or cfg.label
			if not cfg.rainbow then
				pcall(function()
					local se = btn:FindFirstChild("VX_SpinEdge")
					if not se and getgenv().VIREX_SpinEdge then se = getgenv().VIREX_SpinEdge(btn, "white", { thick = 2, z = 6, radius = UDim.new(1, 0) }) end
					if se then se.Visible = active end
				end)
			end
			glass.setActive(active)
			-- apagado: punto rojo; encendido: punto blanco con un halo verde que respira
			tw(dot, 0.3, { BackgroundColor3 = active and Color3.new(1, 1, 1) or SP_RED, Size = active and UDim2.fromOffset(9, 9) or UDim2.fromOffset(8, 8) }, Enum.EasingStyle.Back)
			if active then
				halo.Size = UDim2.fromOffset(8, 8)
				halo.BackgroundTransparency = 0.35
				tw(halo, 1.1, { Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, -1, false)
			else
				tw(halo, 0.2, { BackgroundTransparency = 1, Size = UDim2.fromOffset(8, 8) }, Enum.EasingStyle.Quad)
			end
		end
		if startOn then
			local okOn = cfg.onToggle(true)
			active = okOn ~= false
		end
		paint()

		-- arrastrar desde cualquier parte; si casi no se mueve, cuenta como toque
		local down, moved, startIn, startPos = false, 0, nil, nil
		local dragInput -- el dedo (o raton) que empezo a moverlo; los demas dedos se ignoran
		-- que no se salga nunca de la pantalla
		local function clampPos(x, y)
			local vs = gui.AbsoluteSize
			local sz = btn.AbsoluteSize
			if vs.X < 10 then return x, y end
			x = math.clamp(x, sz.X / 2 + 4, vs.X - sz.X / 2 - 4)
			y = math.clamp(y, 4, vs.Y - sz.Y - 4)
			return x, y
		end
		btn.InputBegan:Connect(function(i)
			if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and not down then
				dragInput = i
				-- posicion de partida en pixeles de pantalla (asi el arrastre es exacto)
				local vs = gui.AbsoluteSize
				local p0 = btn.Position
				btn.Position = UDim2.fromOffset(p0.X.Scale * vs.X + p0.X.Offset, p0.Y.Scale * vs.Y + p0.Y.Offset)
				down, moved, startIn, startPos = true, 0, i.Position, btn.Position
				tw(bsc, 0.15, { Scale = S(0.92) }, Enum.EasingStyle.Quad)
			end
		end)
		UIS2.InputChanged:Connect(function(i)
			if down and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) and getgenv().VIREX_SameDrag(dragInput, i) then
				local d = i.Position - startIn
				moved = math.max(moved, d.Magnitude)
				if moved > 8 then
					local x, y = clampPos(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
					btn.Position = UDim2.fromOffset(x, y)
					savedPos = btn.Position
				end
			end
		end)
		UIS2.InputEnded:Connect(function(i)
			if down and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and getgenv().VIREX_SameDrag(dragInput, i) then
				down = false
				dragInput = nil
				if moved <= 8 and btn.Parent then
					local want = not active
					local res = cfg.onToggle(want)
					active = (res == nil) and want or (res and true or false)
					paint()
					bump(0.86)
					glass.sheen(0.6)
				else
					tw(bsc, 0.35, { Scale = S(1) }, Enum.EasingStyle.Back)
				end
			end
		end)
	end
	return api
end

