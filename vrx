-- ===== SUPER SPAM: mismo boton que SPAM pero arcoiris; dispara varias veces en cada paso del frame =====
getgenv().VIREX_SuperSpam = (function()
	local RunS = game:GetService("RunService")
	local on, conns = false, {}
	local BURST = 1 -- 1 disparo en cada paso del frame (x3 pasos = 3 por frame); mas que eso subia el ping
	-- solo dispara cuando hace falta (si lo dejas encendido no gasta el parry con el balon lejos)
	local need, lastCheck = false, 0
	local function fireBurst()
		if not on or not _capturedRemote then return end
		local now = os.clock()
		if now - lastCheck > 0.05 then
			lastCheck = now
			need = false
			pcall(function()
				local ball = System.ball.get()
				if not ball then return end
				local d = LocalPlayer:DistanceFromCharacter(ball.Position)
				local tgt = ball:GetAttribute("target")
				need = d < 45 or (tgt == LocalPlayer.Name and d < 90)
			end)
		end
		if not need then return end
		for _ = 1, BURST do fireParryRemote(System.curve.get_cframe()) end
	end
	local function stop()
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		conns = {}
	end
	local function setSuper(v)
		if v and not _capturedRemote then
			pcall(function() getgenv().VIREX_ParryHint(true) end)
			pcall(function() Notify("Spam", "Hit the ball once first", 2) end)
			return false
		end
		on = v
		stop()
		if on then
			conns = { RunS.PreSimulation:Connect(fireBurst), RunS.Heartbeat:Connect(fireBurst), RunS.PreRender:Connect(fireBurst) }
		end
		return on
	end
	local btn = VIREX_MakeActionButton({ name = "VIREX_SuperSpam", label = "SUPER SPAM", activeLabel = "SUPER ON", yOffset = 166, rainbow = false, onToggle = setSuper })
	pcall(function() table.insert(getgenv().VIREX_UnloadHooks, function() on = false stop() pcall(btn.show, false) end) end)
	return {
		show = function(s) btn.show(s) end,
		-- tecla: enciende / apaga aunque el boton no este en pantalla
		toggle = function()
			local res = setSuper(not on)
			pcall(btn.set, res)
			pcall(function() Notify("Spam", res and "Super Spam ON" or "Super Spam OFF", 1.5) end)
		end,
	}
end)()

