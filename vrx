	local PER
	local function edgePoint(d)
		-- punto del borde redondeado a la distancia d (empieza arriba a la izquierda, sentido horario)
		local sx, sy = TW - 2 * TR, TH - 2 * TR
		local arc = math.pi * TR / 2
		PER = 2 * sx + 2 * sy + 4 * arc
		d = d % PER
		local segs = {
			{ "l", sx, TR, 0, 1, 0 }, { "a", arc, TW - TR, TR, -math.pi / 2 }, { "l", sy, TW, TR, 0, 1 }, { "a", arc, TW - TR, TH - TR, 0 },
			{ "l", sx, TW - TR, TH, -1, 0 }, { "a", arc, TR, TH - TR, math.pi / 2 }, { "l", sy, 0, TH - TR, 0, -1 }, { "a", arc, TR, TR, math.pi },
		}
		for _, sg in ipairs(segs) do
			if d <= sg[2] then
				if sg[1] == "l" then return sg[3] + sg[5] * d, sg[4] + sg[6] * d end
				local ang = sg[5] + d / TR
				return sg[3] + math.cos(ang) * TR, sg[4] + math.sin(ang) * TR
			end
			d -= sg[2]
		end
		return 0, 0
	end
