	do -- mover la ventana desde arriba o desde el nombre
		local drag, startPos, startIn, inp = false, nil, nil, nil
		local winMove = smooth(root)
		local function begin(i)
			if RZ.zone or RZ.active then return end
			if isPress(i) and not drag then drag, startPos, startIn, inp = true, winMove.goal, i.Position, i end
		end
		-- ===== agrandar / achicar el panel desde sus bordes y esquinas (como en Windows) =====
		local rs = nil -- datos del arrastre de tamano
		local OUT, IN, CORNER = 8, 5, 16
		local function zoneAt(mx, my)
			local p, sz = root.AbsolutePosition, root.AbsoluteSize
			local x0, y0, x1, y1 = p.X, p.Y, p.X + sz.X, p.Y + sz.Y
			if mx < x0 - OUT or mx > x1 + OUT or my < y0 - OUT or my > y1 + OUT then return nil end
			local L = mx <= x0 + IN or (mx <= x0 + CORNER and (my <= y0 + IN or my >= y1 - IN))
			local R = mx >= x1 - IN or (mx >= x1 - CORNER and (my <= y0 + IN or my >= y1 - IN))
			local T = my <= y0 + IN or (my <= y0 + CORNER and (mx <= x0 + IN or mx >= x1 - IN))
			local B = my >= y1 - IN or (my >= y1 - CORNER and (mx <= x0 + IN or mx >= x1 - IN))
			if not (L or R or T or B) then return nil end
			if L and R then R = false end
			if T and B then B = false end
			-- giro de la flecha doble (la imagen va de abajo-izquierda a arriba-derecha)
			local rot
			if (T and R) or (B and L) then rot = 0
			elseif (T and L) or (B and R) then rot = 90
			elseif L or R then rot = 45
			else rot = -45 end
			return { L = L, R = R, T = T, B = B }, rot
		end
		RunService.RenderStepped:Connect(function()
			if rs or drag then return end
			if not (open and root.Visible and UIS.MouseEnabled) or capturing then RZ.zone = nil return end
			local m = UIS:GetMouseLocation()
			RZ.zone, RZ.rot = zoneAt(m.X, m.Y)
		end)
		UIS.InputBegan:Connect(function(i)
			if i.UserInputType ~= Enum.UserInputType.MouseButton1 or not RZ.zone or rs then return end
			closeDrops()
			rs = { z = RZ.zone, m0 = UIS:GetMouseLocation(), w0 = RW, h0 = RH, g0 = winMove.goal, k = math.max(fit.Scale, 0.05) }
			RZ.active = true
		end)
		UIS.InputChanged:Connect(function(i)
			if not rs or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
			local m = UIS:GetMouseLocation()
			local du, dv = (m.X - rs.m0.X) / rs.k, (m.Y - rs.m0.Y) / rs.k
			local vs = gui.AbsoluteSize
			local maxW = math.min(MAX_W, (vs.X - 16) / rs.k)
			local maxH = math.min(MAX_H, (vs.Y - 16) / rs.k)
			local w, h = rs.w0, rs.h0
			if rs.z.R then w = rs.w0 + du elseif rs.z.L then w = rs.w0 - du end
			if rs.z.B then h = rs.h0 + dv elseif rs.z.T then h = rs.h0 - dv end
			w = math.floor(math.clamp(w, MIN_W, math.max(MIN_W, maxW)))
			h = math.floor(math.clamp(h, MIN_H, math.max(MIN_H, maxH)))
			-- el lado contrario se queda quieto: el centro se mueve la mitad de lo que crece
			local cx = (w - rs.w0) * rs.k / 2 * (rs.z.L and -1 or (rs.z.R and 1 or 0))
			local cy = (h - rs.h0) * rs.k / 2 * (rs.z.T and -1 or (rs.z.B and 1 or 0))
			RW, RH = w, h
			root.Size = UDim2.fromOffset(w, h)
			local g = UDim2.new(rs.g0.X.Scale, rs.g0.X.Offset + cx, rs.g0.Y.Scale, rs.g0.Y.Offset + cy)
			winMove.goal = g
			root.Position = g
		end)
		UIS.InputEnded:Connect(function(i)
			if not rs or i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
			rs = nil
			RZ.active = false
			rt._flags.VIREX_UI_W, rt._flags.VIREX_UI_H = RW, RH
			rt._changed()
			for _, pg in pairs(pages) do pcall(rebalance, pg) end
		end)
		dragHit.InputBegan:Connect(begin)
		brand.InputBegan:Connect(begin)
		UIS.InputChanged:Connect(function(i)
			if drag and isMove(i) and sameDrag(inp, i) then
				local d = i.Position - startIn
				winMove.goal = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
		UIS.InputEnded:Connect(function(i) if drag and isPress(i) and sameDrag(inp, i) then drag = false inp = nil end end)
	end

