	-- ===================== MY PLAYLIST: añadir canciones facil =====================
	do
		local function cleanUrl(url)
			url = tostring(url or "")
			url = (url:gsub("^%s+", ""))
			url = (url:gsub("%s+$", ""))
			return url
		end
		local function checkUrl(url)
			if not url:match("^https?://") then return "Paste a link that starts with https://" end
			local low = url:lower()
			if low:find("spotify%.com") or low:find("youtube%.com") or low:find("youtu%.be") or low:find("soundcloud%.com") or low:find("music%.apple") then
				return "Spotify / YouTube links can't play. Use a direct .mp3 or .ogg link (catbox.moe)"
			end
			return nil
		end
		local function nameFromUrl(url)
			local path = (url:gsub("[%?#].*$", ""))
			local nm = path:match("([^/]+)$") or "Song"
			nm = (nm:gsub("%.%w+$", ""))
			nm = (nm:gsub("[_%%]+", " "))
			if #nm > 28 then nm = nm:sub(1, 28) end
			return nm
		end
		local function note(t)
			UI:notify({ title = "My Playlist", text = t, duration = 3.2, allow = true })
		end
		local mySongs, nameBox, linkBox
		local function myNames()
			local out = {}
			for _, e in ipairs(PLAYLIST) do out[#out + 1] = e.name end
			if #out == 0 then out[1] = "(empty)" end
			return out
		end
		local function refreshLists(playFirst, linkEntry)
			rebuildSongs(linkEntry)
			table.clear(cache)
			table.clear(names)
			for i, sng in ipairs(SONGS) do names[i] = sng.name end
			pcall(function() song:set_options(names, names[1]) end)
			pcall(function()
				local mn = myNames()
				mySongs:set_options(mn, mn[#mn])
			end)
			if playFirst then play(1) end
		end
		getgenv().VIREX_SongNamesUpdated = function(reorder)
			local cur = SONGS[M.idx]
			if reorder and not M.playing then
				orderSongs()
				table.clear(cache)
			else
				applySongNames()
			end
			table.clear(names)
			for i, sng in ipairs(SONGS) do names[i] = sng.name end
			if reorder and not M.playing then
				M.idx = 1
			else
				M.idx = table.find(SONGS, cur) or M.idx
			end
			pcall(function() song:set_options(names, names[M.idx]) end)
		end
		local function indexOf(label)
			for i, sng in ipairs(SONGS) do
				if sng.name == label then return i end
			end
			return nil
		end

		local PG = MiscTab:create_group("My Playlist", "right")
		PG:remove() -- (quitado del panel; las canciones que ya anadiste siguen en la lista de Play Music)
		local tutRow = PG:create_button(nil, { title = "How To Add Songs", description = "Step by step: get a song link", button_text = "Tutorial", callback = function()
			pcall(function()
				getgenv().VIREX_ShowBoard({
					title = "Add your songs", subtitle = "4 easy steps", button = "Got it",
					items = {
						{ "Get the song", "Download the song you want (.mp3)." },
						{ "Upload it to catbox", "Go to catbox.moe and upload the song.", copy = "https://catbox.moe" },
						{ "Copy the link", "catbox gives you a link. Copy it." },
						{ "Paste it in the script", "Paste the link in Song Link and tap Add." },
					},
				})
			end)
		end })
		local cbRow = PG:create_button(nil, { title = "catbox.moe", description = "Copy the site link, open it in your browser", button_text = "Copy", callback = function()
			local fn = setclipboard or toclipboard
			local ok2 = fn and pcall(fn, "https://catbox.moe")
			pcall(function() UI:notify({ title = "catbox.moe", text = ok2 and "Link copied! Paste it in your browser" or "https://catbox.moe", duration = 3, allow = true }) end)
		end })
		PG:create_label(nil, { title = "How to add", text = "Write a name, paste a direct .mp3 / .ogg link (catbox.moe, GitHub raw) and press Add" })
		nameBox = PG:create_textbox(nil, { title = "Song Name", description = "Any name you want", placeholder = "My song" })
		linkBox = PG:create_textbox(nil, { title = "Song Link", description = "Direct .mp3 / .ogg link", placeholder = "https://...mp3" })
		PG:create_button(nil, { title = "Add To Playlist", description = "Saves it and plays it now", button_text = "Add", callback = function()
			local url = cleanUrl(linkBox:get_value())
			local bad = checkUrl(url)
			if bad then return note(bad) end
			local nm = tostring(nameBox:get_value() or "")
			nm = (nm:gsub("^%s+", ""))
			if nm == "" then nm = nameFromUrl(url) end
			for _, e in ipairs(PLAYLIST) do
				if e.url == url then return note("That song is already in your playlist") end
			end
			PLAYLIST[#PLAYLIST + 1] = { name = nm, url = url }
			local saved = savePlaylist()
			nameBox:set_value("")
			linkBox:set_value("")
			refreshLists(false)
			local i = indexOf("* " .. nm)
			if i then play(i) end
			note(saved and ("Added " .. nm) or ("Added " .. nm .. " (your executor can't save it for next time)"))
		end })
		PG:create_button(nil, { title = "Play Link Once", description = "Plays the link without saving it", button_text = "Play", callback = function()
			local url = cleanUrl(linkBox:get_value())
			local bad = checkUrl(url)
			if bad then return note(bad) end
			local nm = tostring(nameBox:get_value() or "")
			if nm:gsub("%s", "") == "" then nm = nameFromUrl(url) end
			refreshLists(true, { name = "[Link] " .. nm, urls = { url }, link = true })
		end })
		local mn = myNames()
		mySongs = PG:create_dropdown(nil, { title = "My Songs", description = "Your saved songs", options = mn, default = mn[1] })
		PG:create_button(nil, { title = "Play Selected", description = "Plays the song picked above", button_text = "Play", callback = function()
			local v = mySongs:get_value()
			local i = v and indexOf("* " .. tostring(v))
			if not i then return note("Add a song first") end
			play(i)
		end })
		PG:create_button(nil, { title = "Remove Selected", description = "Deletes it from your playlist", button_text = "Remove", callback = function()
			local v = mySongs:get_value()
			for k, e in ipairs(PLAYLIST) do
				if e.name == v then
					table.remove(PLAYLIST, k)
					savePlaylist()
					refreshLists(false)
					return note("Removed " .. tostring(v))
				end
			end
			note("Nothing to remove")
		end })
		PG:create_button(nil, { title = "My Music Folder", description = "Loads .mp3 / .ogg from workspace/VIREX/MyMusic", button_text = "Reload", callback = function()
			refreshLists(false)
			local n = 0
			for _, sng in ipairs(SONGS) do if sng.mine then n += 1 end end
			note((n > 0) and (n .. " songs from your folder") or "No .mp3 / .ogg in workspace/VIREX/MyMusic")
		end })
	end
end

-- ===================== WORLD VIEW: textura del mapa y filtro de color (solo lo ves tu) =====================
do
	local Lighting = game:GetService("Lighting")
	local TEX = {
		Smooth = Enum.Material.SmoothPlastic, Neon = Enum.Material.Neon, Glass = Enum.Material.Glass,
		ForceField = Enum.Material.ForceField, Ice = Enum.Material.Ice, Marble = Enum.Material.Marble,
		Metal = Enum.Material.DiamondPlate, Sand = Enum.Material.Sand, Wood = Enum.Material.WoodPlanks,
	}
	local TEX_NAMES = { "Default", "Smooth", "Neon", "Glass", "ForceField", "Ice", "Marble", "Metal", "Sand", "Wood" }
	local cur = "Default"
	local orig = setmetatable({}, { __mode = "k" })
	local decals = setmetatable({}, { __mode = "k" })
	-- no se tocan personajes, balones ni cosas de VIREX
	local function skip(part)
		if part.Name:sub(1, 6) == "VIREX_" then return true end
		local cam = workspace.CurrentCamera
		if cam and part:IsDescendantOf(cam) then return true end
		for _, n in ipairs({ "Alive", "Dead", "Balls", "TrainingBalls" }) do
			local f = workspace:FindFirstChild(n)
			if f and part:IsDescendantOf(f) then return true end
		end
		local m = part:FindFirstAncestorOfClass("Model")
		if m and m:FindFirstChildOfClass("Humanoid") then return true end
		return false
	end
	local function applyOne(d)
		if d:IsA("BasePart") then
			if skip(d) then return end
			if not orig[d] then
				local okV, var = pcall(function() return d.MaterialVariant end)
				orig[d] = { d.Material, okV and var or "" }
			end
			local m = TEX[cur]
			if m then
				pcall(function() d.MaterialVariant = "" end)
				d.Material = m
			else
				d.Material = orig[d][1]
				pcall(function() d.MaterialVariant = orig[d][2] end)
			end
		elseif d:IsA("Decal") or d:IsA("Texture") then
			-- con una textura nueva se esconden las texturas pegadas del mapa (y vuelven en Default)
			local p = d.Parent
			if p and p:IsA("BasePart") and skip(p) then return end
			if decals[d] == nil then decals[d] = d.Transparency end
			d.Transparency = (cur ~= "Default") and 1 or decals[d]
		end
	end
	local applyId = 0
	local function applyAll()
		applyId += 1
		local my = applyId
		task.spawn(function()
			local list = workspace:GetDescendants()
			for i, d in ipairs(list) do
				if my ~= applyId then return end
				pcall(applyOne, d)
				if i % 700 == 0 then task.wait() end -- sin congelar el juego
			end
		end)
	end
	-- mapas nuevos (cada ronda) tambien cambian
	workspace.DescendantAdded:Connect(function(d)
		if cur ~= "Default" and (d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture")) then
			task.defer(function() pcall(applyOne, d) end)
		end
	end)

	-- filtros de color
	local FILTERS = {
		Default = nil,
		Vivid = { tint = Color3.fromRGB(255, 255, 255), sat = 0.35, con = 0.12, bri = 0 },
		Cinematic = { tint = Color3.fromRGB(255, 238, 222), sat = -0.15, con = 0.22, bri = -0.03 },
		Night = { tint = Color3.fromRGB(185, 198, 255), sat = -0.12, con = 0.14, bri = -0.08 },
		Purple = { tint = Color3.fromRGB(222, 190, 255), sat = 0.1, con = 0.1, bri = -0.02 },
		Warm = { tint = Color3.fromRGB(255, 222, 196), sat = 0.08, con = 0.06, bri = 0 },
		Ice = { tint = Color3.fromRGB(205, 235, 255), sat = -0.05, con = 0.08, bri = 0.02 },
		["Black & White"] = { tint = Color3.fromRGB(255, 255, 255), sat = -1, con = 0.15, bri = 0 },
	}
	local FILTER_NAMES = { "Default", "Vivid", "Cinematic", "Night", "Purple", "Warm", "Ice", "Black & White" }
	local cc
	local function setFilter(name)
		local f = FILTERS[name]
		if not f then
			if cc then pcall(function() cc:Destroy() end) cc = nil end
			return
		end
		if not cc or not cc.Parent then
			cc = Instance.new("ColorCorrectionEffect")
			cc.Name = "VIREX_ViewFilter"
			cc.Parent = Lighting
		end
		cc.TintColor, cc.Saturation, cc.Contrast, cc.Brightness = f.tint, f.sat, f.con, f.bri
	end

	pcall(function() table.insert(getgenv().VIREX_UnloadHooks, function() cur = "Default" pcall(applyAll) pcall(setFilter, "Default") end) end)
	local G = VisualTab:create_group("World View", "left")
	G:create_dropdown("VIREX_View_Texture", { title = "Map Texture", description = "Change the look of the map", options = TEX_NAMES, default = "Default", callback = function(v)
		cur = v
		applyAll()
	end })
	G:create_dropdown("VIREX_View_Filter", { title = "Color Filter", description = "Color style of the game", options = FILTER_NAMES, default = "Default", callback = function(v)
		pcall(setFilter, v)
	end })
end

-- ===================== SHADERS: luz y colores del mundo (solo lo ves tu) =====================
do
	local Lighting = game:GetService("Lighting")
