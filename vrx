	local function id3Title(d)
		if type(d) ~= "string" or d:sub(1, 3) ~= "ID3" then return nil end
		local ver = d:byte(4) or 3
		local function ss(i)
			local a, b, c, e = d:byte(i, i + 3)
			return ((a or 0) % 128) * 2097152 + ((b or 0) % 128) * 16384 + ((c or 0) % 128) * 128 + ((e or 0) % 128)
		end
		local function u32(i)
			local a, b, c, e = d:byte(i, i + 3)
			return (a or 0) * 16777216 + (b or 0) * 65536 + (c or 0) * 256 + (e or 0)
		end
		local size = ss(7) + 10
		local pos = 11
		if (d:byte(6) or 0) % 128 >= 64 then pos += (ver == 4 and ss(11) or (u32(11) + 4)) end
		local title
		local stop = math.min(size, #d)
		while pos + 10 <= stop do
			local id = d:sub(pos, pos + 3)
			if not id:match("^[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]$") then break end
			local fs = ver == 4 and ss(pos + 4) or u32(pos + 4)
			if fs <= 0 or fs > 20000000 then break end
			if id == "TIT2" then
				local body = d:sub(pos + 10, pos + 9 + fs)
				local enc = body:byte(1)
				local s = body:sub(2)
				if enc == 1 or enc == 2 then
					local le = enc == 1
					if enc == 1 then
						local b1, b2 = s:byte(1, 2)
						if b1 == 0xFE and b2 == 0xFF then le = false s = s:sub(3) elseif b1 == 0xFF and b2 == 0xFE then s = s:sub(3) end
					end
					local out = {}
					for k = 1, #s - 1, 2 do
						local a, b = s:byte(k, k + 1)
						local cp = le and (a + b * 256) or (a * 256 + b)
						if cp == 0 then break end
						if cp < 0xD800 or cp > 0xDFFF then out[#out + 1] = utf8.char(cp) end
					end
					s = table.concat(out)
				else
					s = (s:gsub("%z.*$", ""))
				end
				s = s:gsub("^%s+", ""):gsub("%s+$", "")
				if s ~= "" then title = s end
				break
			end
			pos += 10 + fs
		end
		if title and #title > 40 then title = title:sub(1, 40) end
		return title
	end
