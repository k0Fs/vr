function Lib._new()
	-----------------------------------------------------------------------
	-- VIREX UI "dark pro": barra lateral con secciones, buscador arriba,
	-- tarjetas en 2 columnas. Cada funcion lleva su tecla, aviso e interruptor
	-- a la vista, y TODAS sus opciones dentro de la tarjeta (nada escondido).
	-----------------------------------------------------------------------
	local rt = { _flags = {}, _config = {} }
	local HttpService = game:GetService("HttpService")
	local CONFIG_PATH = "VIREX/BladeBall_Config.json"
	rt._autosave = true
	rt._born = os.clock()
	do
		local saved
		pcall(function()
			if isfile and readfile and isfile(CONFIG_PATH) then saved = HttpService:JSONDecode(readfile(CONFIG_PATH)) end
		end)
		if type(saved) == "table" then
			if saved.__autosave == false then
				rt._autosave = false
			else
				for k, val in pairs(saved) do
					if type(k) == "string" and k:sub(1, 2) ~= "__" then rt._flags[k] = val end
				end
				rt._loadedConfig = true
			end
		end
	end
	local function writeConfig(data)
		if not writefile then return false end
		return (pcall(function()
			if makefolder and isfolder and not isfolder("VIREX") then makefolder("VIREX") end
			writefile(CONFIG_PATH, HttpService:JSONEncode(data))
		end))
	end
	local saveQueued = false
	function rt:_save(force)
		if not (force or rt._autosave) then return false end
		local data = { __autosave = rt._autosave }
		for k, val in pairs(rt._flags) do
			local t = type(val)
			if t == "boolean" or t == "number" or t == "string" then data[k] = val end
		end
		return writeConfig(data)
	end
	function rt._changed()
		if not rt._autosave or saveQueued then return end
		saveQueued = true
		task.delay(0.6, function()
			saveQueued = false
			rt:_save()
		end)
	end
	function rt:set_autosave(on)
		rt._autosave = on == true
		if rt._autosave then rt:_save(true) else writeConfig({ __autosave = false }) end
	end
	function rt:get_autosave() return rt._autosave end
	function rt:save_now() return rt:_save(true) end
	function rt:reset_config() return writeConfig({ __autosave = rt._autosave }) end
	local function keyFromName(n)
		if type(n) ~= "string" then return nil end
		local ok, k = pcall(function() return Enum.KeyCode[n] end)
		return ok and k or nil
	end

	-- ===== colores =====
	local RW, RH, SIDE, TOPH = 780, 500, 188, 62
	-- tamano guardado (el panel se puede agrandar desde sus bordes)
	local MIN_W, MIN_H, MAX_W, MAX_H = 700, 480, 1400, 900
	do
		local w, h = tonumber(rt._flags.VIREX_UI_W), tonumber(rt._flags.VIREX_UI_H)
		if w and h then RW, RH = math.clamp(math.floor(w), MIN_W, MAX_W), math.clamp(math.floor(h), MIN_H, MAX_H) end
	end
	local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
	local C = {
		win = rgb(8, 8, 10), side = rgb(10, 10, 13), card = rgb(13, 13, 16), ctrl = rgb(19, 19, 23), ctrlHi = rgb(26, 26, 31),
		line = rgb(27, 27, 33), line2 = rgb(40, 40, 48), text = rgb(236, 236, 241), sub = rgb(116, 116, 128), faint = rgb(74, 74, 86),
		off = rgb(34, 34, 40), offKnob = rgb(112, 112, 124),
	}
	local ACC = rgb(226, 226, 232)
	local ACCENTS = { White = rgb(226, 226, 232), Blue = rgb(70, 140, 255), Red = rgb(235, 55, 70), Purple = rgb(150, 95, 245), Pink = rgb(240, 95, 190),
		Green = rgb(70, 215, 120), Cyan = rgb(50, 205, 230), Gold = rgb(240, 190, 60), Orange = rgb(250, 135, 45) }
	local accRefs = {} -- { obj, prop, when = function() -> bool } cosas que llevan el color de acento
	local function onAcc(o, prop, when)
		accRefs[#accRefs + 1] = { o = o, p = prop, w = when }
		if not when or when() then pcall(function() o[prop] = ACC end) end
	end
	local function accDark() -- texto sobre el acento: oscuro si el acento es claro
		local h, s, v = ACC:ToHSV()
		local _ = h
		return (v > 0.75 and s < 0.35) and rgb(10, 10, 12) or WHITE
	end
	local FN = Enum.Font.GothamMedium
	local FNB = Enum.Font.GothamBold
	local FNK = Enum.Font.GothamBlack

	-- ===== ventana =====
	local gui = new("ScreenGui", { Name = "VirexPanel", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100 })
	skinGui(gui)
	pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
	gui.Parent = guiParent()
	local root = new("Frame", { Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(RW, RH), BackgroundTransparency = 1, Visible = false })
	local fit = new("UIScale", { Parent = root })
	local uiMul = 1
	local function refit()
		local v = gui.AbsoluteSize
		local sc
		if UIS.TouchEnabled and not UIS.MouseEnabled then
			-- movil: el panel ocupa como mucho ~3/4 del alto de la pantalla (antes casi toda: se veia gigante)
			sc = math.max(0.35, math.min(0.62, (v.X - 24) / RW * 0.8, (v.Y - 24) / RH * 0.76))
		else
			sc = math.max(0.45, math.min(1.25, (v.X - 40) / RW, (v.Y - 40) / RH))
		end
		fit.Scale = sc * uiMul
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	refit()
	function rt:set_ui_scale(pct)
		uiMul = math.clamp((tonumber(pct) or 100) / 100, 0.6, 1.5)
		refit()
