			lab(row, { Position = UDim2.fromOffset(54, 29), Size = UDim2.new(1, textW, 0, h - 35), Text = it[2] or "", Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = C_SUB, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 3 })
			if it.copy then
