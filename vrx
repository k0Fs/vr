function FX.holder(hd, box, hdH)
	local hold = new("Frame", { Name = "VX_FxHold", Parent = hd, Size = UDim2.new(1, 0, 0, hdH), BackgroundTransparency = 1, ZIndex = 0 })
	local function fit()
		local sy = hd.AbsoluteSize.Y
		if sy < 1 then return end
		local k = sy / hdH
		local h = math.floor(box.AbsoluteSize.Y / k + 0.5)
		if hold.Size.Y.Offset ~= h then hold.Size = UDim2.new(1, 0, 0, h) end
	end
	box:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	hd:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	task.defer(fit)
	return hold
end
