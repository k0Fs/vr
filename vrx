		end
	end })
	pcall(function()
		local b = pauseRow.frame:FindFirstChildWhichIsA("TextButton")
		local lbl = b and b:FindFirstChildWhichIsA("TextLabel")
		if not lbl then return end
		task.spawn(function()
			while lbl.Parent do
