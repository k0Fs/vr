	local function paintSwitch(track, knob, tst, on, anim)
		local props1 = { BackgroundColor3 = on and ACC or C.off }
		local props2 = { Position = UDim2.new(0, on and 26 or 10, 0.5, 0), BackgroundColor3 = on and (accDark() == WHITE and WHITE or rgb(250, 250, 252)) or C.offKnob }
		local props3 = { Color = on and ACC or C.line2 }
		if on and accDark() ~= WHITE then props2.BackgroundColor3 = rgb(12, 12, 14) end
		if anim then
			tween(track, 0.22, props1)
			tween(knob, 0.28, props2, Enum.EasingStyle.Back)
			tween(tst, 0.22, props3)
		else
			for k, v in pairs(props1) do track[k] = v end
			for k, v in pairs(props2) do knob[k] = v end
