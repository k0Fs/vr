		local gr = new("Frame", { Name = "VX_Grain", Parent = f, Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = z }, { corner(r) })
		local ks, n = {}, 18
		for i = 0, n do ks[#ks + 1] = KP(i / n, (i % 2 == 0) and (o.grainA or 0.965) or 0.995) end
		new("UIGradient", { Parent = gr, Rotation = 62, Transparency = NumberSequence.new(ks) })
		made.grain = gr
	end
	return made
end
-- ===== piel del UI =====
-- letra (por defecto codigo / RobotoMono), color de acento y sin traduccion automatica (todo en ingles).
-- Se aplica a todo lo de VIREX (panel, avisos, botones flotantes, HUD) y se puede cambiar en Config.
local SKIN = { family = "rbxasset://fonts/families/Arial.json", accH = nil, accS = 1 }
local FONT_FAMILIES = {
	Code = "rbxasset://fonts/families/RobotoMono.json",
	Gotham = "rbxasset://fonts/families/GothamSSm.json",
	Ubuntu = "rbxasset://fonts/families/Ubuntu.json",
	Arial = "rbxasset://fonts/families/Arial.json",
	Fredoka = "rbxasset://fonts/families/FredokaOne.json",
	Oswald = "rbxasset://fonts/families/Oswald.json",
	Arcade = "rbxasset://fonts/families/PressStart2P.json",
	Comic = "rbxasset://fonts/families/ComicNeueAngular.json",
}
local MONO_BOLD = { [Enum.Font.GothamBold] = true, [Enum.Font.GothamBlack] = true, [Enum.Font.SourceSansBold] = true, [Enum.Font.ArialBold] = true }
local SKINNED = {} -- guis con piel
local BOLDMAP = setmetatable({}, { __mode = "k" })
local function fontOne(o)
	if not (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) then return end
	if BOLDMAP[o] == nil then
		if o.Font == Enum.Font.Kalam then BOLDMAP[o] = "skip" return end -- el titulo VIREX de pincel se queda igual
		BOLDMAP[o] = MONO_BOLD[o.Font] == true
	end
	if BOLDMAP[o] == "skip" then return end
	pcall(function() o.FontFace = Font.new(SKIN.family, BOLDMAP[o] and Enum.FontWeight.Bold or Enum.FontWeight.Medium) end)
end
-- color de acento: todo lo azul del UI cambia al color elegido (mismo brillo y textura)
local COLOR_PROPS = {
	Frame = { "BackgroundColor3" }, TextButton = { "BackgroundColor3", "TextColor3" }, TextLabel = { "TextColor3" },
	TextBox = { "BackgroundColor3", "TextColor3" }, ImageLabel = { "ImageColor3", "BackgroundColor3" }, ImageButton = { "ImageColor3", "BackgroundColor3" },
	CanvasGroup = { "BackgroundColor3", "GroupColor3" }, UIStroke = { "Color" },
}
local RAW = setmetatable({}, { __mode = "k" })
local busy = false
local function conv(c)
	if not SKIN.accH then return nil end
	c = Color3.new(math.clamp(c.R, 0, 1), math.clamp(c.G, 0, 1), math.clamp(c.B, 0, 1))
	local h, sat, v = c:ToHSV()
	if h >= 0.53 and h <= 0.70 and sat >= 0.2 then return Color3.fromHSV(SKIN.accH, sat * SKIN.accS, v) end
	return nil
end
local function convSeq(seqC)
	local ks, changed = {}, false
	for _, k in ipairs(seqC.Keypoints) do
		local n = conv(k.Value)
		if n then changed = true end
		ks[#ks + 1] = ColorSequenceKeypoint.new(k.Time, n or k.Value)
	end
	return changed and ColorSequence.new(ks) or seqC
end
local function paintProp(o, pr)
	local raw = RAW[o][pr]
	local val = raw
	if pr == "Color" and o:IsA("UIGradient") then val = convSeq(raw) else val = conv(raw) or raw end
	local same = false
	pcall(function() same = o[pr] == val end)
	if same then return end
	busy = true
	pcall(function() o[pr] = val end)
	busy = false
end
local function colorOne(o)
	if o:GetAttribute("VX_NoSkin") then return end
	local props = COLOR_PROPS[o.ClassName]
	if o:IsA("UIGradient") then props = { "Color" } end
	if not props then return end
	if not RAW[o] then
		RAW[o] = {}
		for _, pr in ipairs(props) do
			RAW[o][pr] = o[pr]
			o:GetPropertyChangedSignal(pr):Connect(function()
				if busy then return end
				RAW[o][pr] = o[pr]
				if SKIN.accH then paintProp(o, pr) end
			end)
		end
	end
	if SKIN.accH or RAW[o].__painted then
		for _, pr in ipairs(props) do paintProp(o, pr) end
		RAW[o].__painted = SKIN.accH ~= nil
	end
end
local function skinOne(o)
	fontOne(o)
	colorOne(o)
end
local function skinGui(g)
	pcall(function() g.AutoLocalize = false end)
	table.insert(SKINNED, g)
	for _, d in ipairs(g:GetDescendants()) do skinOne(d) end
	g.DescendantAdded:Connect(function(d) task.defer(skinOne, d) end)
end
local reskinTok = {}
local function reskinAll(mode)
	mode = mode or "all"
	reskinTok[mode] = (reskinTok[mode] or 0) + 1
	local my = reskinTok[mode]
	local fn = (mode == "color" and colorOne) or (mode == "font" and fontOne) or skinOne
	task.spawn(function()
		local t0 = os.clock()
		for i = #SKINNED, 1, -1 do
			local g = SKINNED[i]
			if g and not g.Parent then
				table.remove(SKINNED, i)
			elseif g then
				local list = g:GetDescendants()
				for j = 1, #list do
					if reskinTok[mode] ~= my then return end
					pcall(fn, list[j])
					if os.clock() - t0 > 0.006 then
						task.wait()
						t0 = os.clock()
					end
				end
			end
		end
	end)
end
pcall(function() getgenv().VIREX_Skin = skinGui end)

-- ===== LIQUID GLASS FX =====
-- cristal liquido de verdad: dos colores que se mezclan (sale del color del UI y de su vecino),
-- caustica (la luz que hace el agua) que se mueve por dentro, escarcha fina, reflejo arriba,
-- un brillo que cruza de vez en cuando y borde iridiscente que gira. Un solo bucle para todo
-- (30 fps en PC, 20 en movil) y solo para lo que se ve en pantalla.
getgenv().VIREX_FxTex = { fx_caustic_v1 = "", fx_frost_v1 = "" }
local FX = { items = {}, anim = {}, gate = nil, conn = nil }
local function CSK(t, c) return ColorSequenceKeypoint.new(t, c) end
local function NSq(list)
	local ks = {}
	for _, k in ipairs(list) do ks[#ks + 1] = KP(k[1], k[2]) end
	return NumberSequence.new(ks)
end
local function fxPalette()
	if SKIN.accS == 0 then
		return Color3.fromRGB(235, 235, 242), Color3.fromRGB(160, 160, 172), WHITE, Color3.fromRGB(40, 40, 46)
	end
	local h = SKIN.accH or 0.6
	return Color3.fromHSV(h, 0.88, 1), -- principal
		Color3.fromHSV((h - 0.075) % 1, 0.82, 1), -- segundo color (rojo -> rosa / azul -> cian)
		Color3.fromHSV((h + 0.055) % 1, 0.45, 1), -- luz caliente (rojo -> naranja claro)
		Color3.fromHSV(h, 0.9, 0.32) -- color oscuro
end
local function fxNo(o) pcall(function() o:SetAttribute("VX_NoSkin", true) end) return o end
local function fxPaint(e)
	local o = e.o
	if not o.Parent then return false end
	local P, S, Hh, D = fxPalette()
	if e.role == "iri" then
		o.Color = ColorSequence.new({ CSK(0, WHITE), CSK(0.2, P), CSK(0.42, Hh), CSK(0.58, WHITE), CSK(0.78, S), CSK(1, WHITE) })
	elseif e.role == "aur" then
		o.Color = ColorSequence.new({ CSK(0, P), CSK(0.5, D), CSK(1, S) })
	elseif e.role == "duo" then
		o.Color = ColorSequence.new({ CSK(0, P), CSK(0.55, Hh), CSK(1, S) })
	else
		o[e.prop] = (e.role == "p" and P) or (e.role == "s" and S) or (e.role == "h" and Hh) or D
	end
	return true
end
function FX.reg(o, role, prop)
	fxNo(o)
	local e = { o = o, role = role, prop = prop }
	FX.items[#FX.items + 1] = e
	pcall(fxPaint, e)
	return o
end
function FX.recolor()
	for i = #FX.items, 1, -1 do
		local ok, alive = pcall(fxPaint, FX.items[i])
		if ok and alive == false then table.remove(FX.items, i) end
	end
end
local function fxShown(o)
	local q = o
	while q do
		if q:IsA("GuiObject") and not q.Visible then return false end
		if q:IsA("LayerCollector") then return q.Enabled ~= false end
		q = q.Parent
	end
	return false
end
function FX.start()
	if FX.conn or MOBILE_BUILD then return end
	local step = (UIS.TouchEnabled and not UIS.MouseEnabled) and (1 / 20) or (1 / 30)
	local acc, visT = 0, 1
	FX.conn = game:GetService("RunService").RenderStepped:Connect(function(dt)
		acc += dt
		visT += dt
		if acc < step then return end
		acc = 0
		if FX.gate and not FX.gate() then return end
		local t = os.clock()
		local recheck = visT > 0.4
		if recheck then visT = 0 end
		local list = FX.anim
		for i = #list, 1, -1 do
			local e = list[i]
			local g = e.g
			if not g.Parent then
				table.remove(list, i)
			else
				if recheck then e.vis = fxShown(e.host) end
				if e.vis then
					if e.kind == "sweep" then
						local ph = ((t + e.b) % e.a) / e.a
						g.Offset = Vector2.new(-1.25 + 2.5 * ph, 0)
					else
						g.Rotation = (t * e.a + e.b) % 360
					end
				end
			end
		end
	end)
end
function FX.animate(g, kind, host, a, b)
	FX.anim[#FX.anim + 1] = { g = g, kind = kind, host = host, a = a, b = b or 0, vis = true }
	FX.start()
	return g
end
local FX_TEX = {}
local function fxTex(nm)
	if FX_TEX[nm] == nil then
		local a
		pcall(function() a = getgenv().VIREX_IconAsset and getgenv().VIREX_IconAsset(nm) end)
		FX_TEX[nm] = (type(a) == "string" and a ~= "") and a or false
	end
	return FX_TEX[nm] or nil
end
-- capa de cristal liquido completa sobre un marco (f), con esquinas r
function FX.glass(f, r, o)
	o = o or {}
	local z = o.z or f.ZIndex
	local rnd = math.random() * 10
	local function layer(name, col)
		return new("Frame", { Name = name, Parent = f, Size = UDim2.fromScale(1, 1), BackgroundColor3 = col or WHITE, BorderSizePixel = 0, ZIndex = z }, { corner(r) })
	end
	-- 1) color principal que entra por arriba a la izquierda
	local a = FX.reg(layer("VX_FxA"), "p", "BackgroundColor3")
	fxNo(new("UIGradient", { Parent = a, Rotation = 125, Transparency = NSq({ { 0, o.tintA or 0.5 }, { 0.42, 0.88 }, { 1, 1 } }) }))
	-- 2) segundo color que sube desde abajo a la derecha
	local b = FX.reg(layer("VX_FxB"), "s", "BackgroundColor3")
	fxNo(new("UIGradient", { Parent = b, Rotation = -55, Transparency = NSq({ { 0, o.tintB or 0.6 }, { 0.48, 0.93 }, { 1, 1 } }) }))
	-- 3) caustica: la luz de agua por dentro, con una banda mas brillante que la recorre despacio
	if o.caustic ~= false then
		local tex = fxTex("fx_caustic_v1")
		if tex then
			local ts = o.tile or 170
			local im = new("ImageLabel", { Name = "VX_FxC", Parent = f, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = tex, ScaleType = Enum.ScaleType.Tile, TileSize = UDim2.fromOffset(ts, ts), ImageTransparency = o.causticT or 0.5, ZIndex = z }, { corner(r) })
			FX.reg(im, "h", "ImageColor3")
			local cg = fxNo(new("UIGradient", { Parent = im, Rotation = 28, Transparency = NSq({ { 0, 0.82 }, { 0.36, 0.8 }, { 0.5, 0.05 }, { 0.64, 0.8 }, { 1, 0.82 } }) }))
			FX.animate(cg, "sweep", im, o.period or 7, rnd)
		end
	end
	-- 4) escarcha muy fina (textura de cristal)
	if o.frost ~= false then
		local tex = fxTex("fx_frost_v1")
		if tex then
			fxNo(new("ImageLabel", { Name = "VX_FxF", Parent = f, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = tex, ScaleType = Enum.ScaleType.Tile, TileSize = UDim2.fromOffset(96, 96), ImageTransparency = o.frostT or 0.64, ZIndex = z }, { corner(r) }))
		end
	end
	-- 5) reflejo arriba (luz blanca que baja y se apaga)
	local sp = fxNo(new("Frame", { Name = "VX_FxSpec", Parent = f, Size = UDim2.new(1, 0, o.specH or 0.55, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = z }, { corner(r) }))
	fxNo(new("UIGradient", { Parent = sp, Rotation = 90, Transparency = NSq({ { 0, o.specT or 0.66 }, { 0.5, 0.9 }, { 1, 1 } }) }))
	-- 6) brillo que cruza en diagonal
	if o.sheen ~= false then
		local sh = fxNo(layer("VX_FxSheen"))
		local sg = fxNo(new("UIGradient", { Parent = sh, Rotation = 22, Offset = Vector2.new(-1.25, 0), Transparency = NSq({ { 0, 1 }, { 0.42, 1 }, { 0.5, o.sheenT or 0.74 }, { 0.58, 1 }, { 1, 1 } }) }))
		FX.animate(sg, "sweep", sh, o.sheenP or 5, rnd)
	end
	-- 7) borde iridiscente que gira (usa el borde que ya tiene, si tiene)
	if o.stroke ~= false then
		local st = o.strokeObj or f:FindFirstChildOfClass("UIStroke") or new("UIStroke", { Parent = f, Thickness = o.th or 1.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
		for _, g in ipairs(st:GetChildren()) do if g:IsA("UIGradient") then g:Destroy() end end
		fxNo(st)
		st.Color = WHITE
		if o.th then st.Thickness = o.th end
		st.Transparency = o.strokeT or 0
		local ig = FX.reg(new("UIGradient", { Parent = st, Transparency = NSq({ { 0, 0.02 }, { 0.25, 0.4 }, { 0.5, 0.12 }, { 0.75, 0.45 }, { 1, 0.02 } }) }), "iri")
		FX.animate(ig, "spin", f, o.spin or 42, rnd * 36)
	end
	-- 8) borde de luz por dentro (refraccion)
	glassPolish(f, r, { z = z, rim = o.rim ~= false, rimT = 0.05, glow = false, innerT = 0.68, innerB = 0.5 })
end
