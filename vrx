		local ok = mk("TextButton", { Parent = inner, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(1, -32, 0, 42), BackgroundColor3 = Color3.fromRGB(236, 236, 241), Text = "", AutoButtonColor = false, ZIndex = 3 }, { rc(10) })
		local okL = lab(ok, { Size = UDim2.fromScale(1, 1), Text = o.button or "Got it", TextSize = 14, TextColor3 = Color3.fromRGB(10, 10, 12), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
		local okSc = mk("UIScale", { Parent = ok })
