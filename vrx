		end
	end)
	-- el peor ping de los ultimos 2.5 s (si te sube de golpe, el parry ya lo tiene en cuenta)
	local function worstPing()
		local m = 0
		for _, v in ipairs(pingHist) do if v > m then m = v end end
		return math.max(m, E.Get_Ping())
	end
	-- LATENCIA REAL para el spam (ms): ping medio de los ultimos 2.5 s + lo que varia (jitter).
	-- Con lag el ping no es fijo: lo que cuenta es lo que tarda en el peor caso normal, no un numero suelto.
	local function latMs()
		local now = E.Get_Ping()
		local n, sum, lo, hi = 0, 0, math.huge, 0
		for _, v in ipairs(pingHist) do
			n += 1
			sum += v
			if v < lo then lo = v end
			if v > hi then hi = v end
		end
		if n < 3 then return now + (MOB and 20 or 0) end
		local jitter = (hi - lo) / 2
		return math.max(now, sum / n + jitter * 1.5) + (MOB and 20 or 0)
	end
