		function g:create_toggle(flag, v)
			flag, v = args(flag, v)
			local state = v.default == true
			if flag and rt._flags[flag] ~= nil then state = rt._flags[flag] == true end
			local order = nextOrder()
			g.rows += 1
			local title = tostring(v.title or flag or "Toggle")
			local merged = g.rows == 1 and string.lower(title) == string.lower(g.title)
			if merged then head.Visible = false end
			local first = merged or g.rows == 1
			local y0 = first and 0 or 12
			local hasDesc = v.description ~= nil and tostring(v.description) ~= ""
			-- tecla solo en las funciones importantes (y nunca en movil sin teclado)
			local wantKey = v.keybind == true and not (UIS.TouchEnabled and not UIS.KeyboardEnabled)
			local rightW = wantKey and 100 or 44
			local r = new("Frame", { Parent = box, LayoutOrder = order, Size = UDim2.new(1, 0, 0, y0 + (hasDesc and 46 or 30)), BackgroundTransparency = 1, ZIndex = 3 })
			local div = divider(r)
			div.Visible = not first
			local tl = txt(r, { Position = UDim2.fromOffset(0, y0 + 2), Size = UDim2.new(1, -rightW, 0, 18), Text = title, Font = merged and FNB or FN, TextSize = merged and 14 or 13, TextColor3 = C.text, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3 })
			local dl = txt(r, { Name = "Desc", Position = UDim2.fromOffset(0, y0 + 22), Size = UDim2.new(1, -rightW, 0, 14), Text = tostring(v.description or ""), Font = FN, TextSize = 11, TextColor3 = C.sub, TextTruncate = Enum.TextTruncate.AtEnd, Visible = hasDesc, ZIndex = 3 })
			local ctl = new("Frame", { Parent = r, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, y0 + (hasDesc and 9 or 2)), Size = UDim2.fromOffset(rightW, 24), BackgroundTransparency = 1, ZIndex = 3 })
			local kb
			if wantKey then
				kb = keyBox(ctl, 0, 0)
			end
			local track, knob, tst = switch(ctl)
			track.Position = UDim2.new(1, 0, 0, 2)
			local hit = new("TextButton", { Parent = ctl, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 4, 0, -2), Size = UDim2.fromOffset(46, 28), BackgroundTransparency = 1, Text = "", ZIndex = 6 })
			-- modo compacto (cuando va DENTRO de otra funcion): titulo + casilla
			local cb, cbSt, cbMark, cbParts = checkbox(r)
			cb.Visible = false
			local cbHit = new("TextButton", { Parent = r, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Visible = false, ZIndex = 6 })
			local m = { frame = r, _order = order, _group = g, _tl = tl, _row = r, _track = track, compact = false }
			local function render(anim)
				paintSwitch(track, knob, tst, state, anim)
				local cbProps = { BackgroundColor3 = state and ACC or C.ctrl }
				if anim then tween(cb, 0.18, cbProps) else cb.BackgroundColor3 = cbProps.BackgroundColor3 end
				cbSt.Color = state and ACC or C.line2
				cbMark.Visible = state
				for _, a in ipairs(cbParts) do a.BackgroundColor3 = accDark() end
			end
			onAcc(track, "BackgroundColor3", function() return state end)
			onAcc(tst, "Color", function() return state end)
			onAcc(cb, "BackgroundColor3", function() return state end)
			onAcc(cbSt, "Color", function() return state end)
			render(false)
			function m:set_value(val, silent)
				state = val == true
				if flag then rt._flags[flag] = state rt._changed() end
				render(true)
				if not silent then safe(v.callback, state) end
			end
			function m:get_value() return state end
			function m:set_visible(x)
				r.Visible = x
				for _, c2 in ipairs(m._links or {}) do pcall(function() c2.frame.Visible = x end) end
			end
			function m:is_visible() return r.Visible end
			if flag then rt._flags[flag] = state end
			hit.Activated:Connect(function() m:set_value(not state) end)
			cbHit.Activated:Connect(function() m:set_value(not state) end)
			-- tecla: pulsa la caja y luego la tecla (Esc / Retroceso = ninguna)
			local bindText = "None"
			local bind = { key = nil, fn = function()
				if v.key_action then safe(v.key_action) else m:set_value(not state) end
			end }
			if flag and wantKey then
				local k = keyFromName(rt._flags[flag .. "__key"])
				if k then bind.key = k bindText = k.Name end
			end
			if wantKey then table.insert(binds, bind) end
			local function paintBind()
				if not kb then return end
				kb.Text = bindText
				kb.TextColor3 = bind.key and C.text or C.sub
			end
			paintBind()
			m.start_bind = function(done)
				if not kb then return end
				bindText = "..."
				paintBind()
				capturing = function(code)
					if code == Enum.KeyCode.Escape or code == Enum.KeyCode.Backspace then
						bind.key = nil
						bindText = "None"
					else
						bind.key = code
						bindText = code.Name
					end
					if flag then rt._flags[flag .. "__key"] = bind.key and bind.key.Name or nil rt._changed() end
					paintBind()
					if done then done(bindText) end
				end
			end
			m.bind_text = function() return bindText end
			if kb then kb.Activated:Connect(function() m.start_bind() end) end
			function m:_setCompact(on)
				m.compact = on
				ctl.Visible = not on
				dl.Visible = (not on) and hasDesc
				cb.Visible = on
				cbHit.Visible = on
				div.Visible = false
				if on then
					tl.Position = UDim2.fromOffset(0, 0)
					tl.Size = UDim2.new(1, -30, 1, 0)
