	-- ===== quitar la musica del juego mientras suena la tuya (los sonidos de golpes se quedan) =====
	local muted = {} -- [Sound o SoundGroup] = volumen original
	local MUSIC_WORDS = { "music", "song", "theme", "bgm", "lobby", "ambien", "soundtrack", "track" }
	local function isGameMusic(o)
		if o == sound then return false end
		local n = string.lower(o.Name)
		for _, w in ipairs(MUSIC_WORDS) do if n:find(w, 1, true) then return true end end
		if o:IsA("Sound") then
			local p = o.Parent
			while p and p ~= game do
				local pn = string.lower(p.Name)
				for _, w in ipairs(MUSIC_WORDS) do if pn:find(w, 1, true) then return true end end
				p = p.Parent
			end
			-- las canciones son largas y se repiten; los golpes duran menos de 5 s
			return o.Looped and o.TimeLength > 25
		end
		return false
	end
	-- antes se revisaba TODO el mapa cada 2 s (tirones de FPS que hacian fallar el parry):
	-- ahora se revisa una sola vez al encender y despues solo los sonidos nuevos que aparecen
	local function muteOne(o)
		if (o:IsA("Sound") or o:IsA("SoundGroup")) and o ~= sound and isGameMusic(o) then
			if muted[o] == nil then muted[o] = o.Volume end
			if o.Volume ~= 0 then pcall(function() o.Volume = 0 end) end
		end
	end
	local muteRoots = function()
		return { game:GetService("SoundService"), workspace, game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui") }
	end
	local muteConns, muteActive = {}, false
	muteScan = function()
		local want = M.muteGame and M.playing
		if not want then
			if muteActive then
				muteActive = false
				for _, c in ipairs(muteConns) do pcall(function() c:Disconnect() end) end
				muteConns = {}
			end
			for o, v in pairs(muted) do pcall(function() o.Volume = v end) end
			muted = {}
			return
		end
		if not muteActive then
			muteActive = true
			for _, root in ipairs(muteRoots()) do
				if root then
					task.spawn(function()
						local list = root:GetDescendants()
						for i, o in ipairs(list) do
							if not muteActive then return end
							pcall(muteOne, o)
							if i % 1500 == 0 then task.wait() end -- repartido en varios frames
						end
					end)
					table.insert(muteConns, root.DescendantAdded:Connect(function(o)
						if o:IsA("Sound") or o:IsA("SoundGroup") then
							task.defer(function() if muteActive then pcall(muteOne, o) end end)
						end
					end))
				end
			end
		else
			-- solo lo ya silenciado (lista corta): por si el juego le vuelve a subir el volumen
			for o in pairs(muted) do
				if o.Parent == nil then muted[o] = nil
				elseif o.Volume ~= 0 then pcall(function() o.Volume = 0 end) end
			end
		end
	end
	task.spawn(function()
		while true do
			task.wait(2)
			pcall(muteScan)
		end
	end)

