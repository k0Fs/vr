	local function placeSpin()
		for k, st in ipairs(streaks) do
			local head = spinD + (k - 1) * PER / 2
			local px, py = edgePoint(head)
			st.halo.Position = UDim2.fromOffset(px, py)
			for i, seg in ipairs(st.segs) do
				local qx, qy = edgePoint(head - i * STEP)
				seg.Position = UDim2.fromOffset((px + qx) / 2, (py + qy) / 2)
				seg.Rotation = math.deg(math.atan2(py - qy, px - qx))
				px, py = qx, qy
			end
		end
	end
	placeSpin()
	RunService.RenderStepped:Connect(function(dt)
		if not root.Visible or not spinRing.Parent then return end
		spinD = (spinD + math.min(dt, 0.1) * 120) % PER -- 120 px por segundo, constante
		placeSpin()
	end)
