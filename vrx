				cb.MouseEnter:Connect(function() tw(cb, 0.15, { BackgroundColor3 = C_HI }) tw(cst, 0.15, { Color = W }) end)
				cb.MouseLeave:Connect(function() tw(cb, 0.2, { BackgroundColor3 = C_CTRL }) tw(cst, 0.2, { Color = C_LINE2 }) end)
				cb.Activated:Connect(function()
					local fn = setclipboard or toclipboard
