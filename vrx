                System.parry.execute()  
                if getgenv().AutoSpamAnimationFix and PF then PF() end  
            end  
        end  
    end)  
end  
  
-- ===== Auto Spam inteligente =====
-- Mira el atributo "target" del balon: si va y viene entre tu y el mismo rival rapido = choque.
-- Solo entonces hace spam (y para en cuanto el choque se acaba). Los golpes del propio spam ya no cuentan.
local SPM = { ball = nil, conn = nil, hist = {}, prev = nil, lastFire = 0 }
local function spmWatch(ball)
    if SPM.ball == ball then return end
    if SPM.conn then pcall(function() SPM.conn:Disconnect() end) SPM.conn = nil end
    SPM.ball = ball
    SPM.hist = {}
    if not ball then return end
    SPM.prev = ball:GetAttribute("target")
    SPM.conn = ball:GetAttributeChangedSignal("target"):Connect(function()
        local t = ball:GetAttribute("target")
        table.insert(SPM.hist, { t = os.clock(), from = SPM.prev, to = t })
        if #SPM.hist > 10 then table.remove(SPM.hist, 1) end
        SPM.prev = t
    end)
end
-- cuantos cambios seguidos entre tu y el rival, y si el choque sigue vivo
local function spmClash(me, foe, now, need)
    local n, firstT, lastT = 0, nil, nil
    for i = #SPM.hist, 1, -1 do
        local h = SPM.hist[i]
        if now - h.t > 1.5 then break end
        if not ((h.to == me and h.from == foe) or (h.to == foe and h.from == me)) then break end
        n += 1
        firstT = h.t
        lastT = lastT or h.t
    end
    if n < need or not lastT then return false end
    -- el choque sigue si el ultimo cambio fue hace poco (segun lo rapido que va el ida y vuelta)
    local avg = n > 1 and (lastT - firstT) / (n - 1) or 0.25
    return now - lastT <= math.clamp(avg * 2.5, 0.22, 0.6)
end
getgenv().VIREX_SpamStyle = getgenv().VIREX_SpamStyle or "Classic"

function System.auto_spam.start()
    -- Classic = el Auto Spam original (el de siempre)
    if (getgenv().VIREX_SpamStyle or "Classic") == "Classic" then return System.auto_spam.start_classic() end
    if System.__properties.__connections.__auto_spam then
        System.__properties.__connections.__auto_spam:Disconnect()
    end
    System.__properties.__auto_spam_enabled = true
    System.__properties.__connections.__auto_spam = RunService.PreSimulation:Connect(function()
        if not System.__properties.__auto_spam_enabled then return end
        local char = LocalPlayer.Character
        if not char or not char.PrimaryPart then return end
        local ball = System.ball.get()
        spmWatch(ball)
        if not ball or System.__properties.__slashesoffury_active then return end
        if System.__triggerbot and System.__triggerbot.__enabled then return end
        local zoomies = ball:FindFirstChild("zoomies")
        if not zoomies then return end
        if char:GetAttribute("Pulsed") then return end
        if System.__config.__detections.__infinity and System.__properties.__infinity_active then return end
        if System.__config.__detections.__deathslash and System.__properties.__deathslash_active then return end
        if System.__config.__detections.__timehole and System.__properties.__timehole_active then return end
        local foe = System.player.get_closest()
        if not foe or not foe.PrimaryPart then return end
        local me, target = LocalPlayer.Name, ball:GetAttribute("target")
        -- el balon tiene que ir entre tu y tu rival (si va a otro, el choque se acabo)
        if target ~= me and target ~= foe.Name then return end
        local style = getgenv().VIREX_SpamStyle
        local now = os.clock()
        local fd = LocalPlayer:DistanceFromCharacter(foe.PrimaryPart.Position)
        local bd = LocalPlayer:DistanceFromCharacter(ball.Position)
        local speed = zoomies.VectorVelocity.Magnitude
        -- choque: 2 idas y vueltas (Fast: 1 si el rival esta pegado a ti)
        local need = 2
        -- rival pegado a ti: basta 1 ida y vuelta (ahi es donde se muere si el spam llega tarde)
        if fd < 12 or (style == "Fast" and fd < 16) then need = 1 end
        if not spmClash(me, foe.Name, now, need) then return end
        -- distancia: crece con la velocidad del balon y tu ping
        local ping = 50
        pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        local range = math.clamp(math.clamp(ping / 10, 1, 16) + speed / 5 + 8, 22, 130)
        if style == "Fast" then range *= 1.15 elseif style == "Safe" then range *= 0.85 end
        if bd > range or fd > range then return end
        -- Safe: solo cuando el balon viene a ti
        if style == "Safe" and target ~= me then return end
        -- ritmo: a tope cuando viene a ti, mas suave cuando acaba de salir hacia el rival
        local gap = target == me and (1 / 90) or (style == "Fast" and 1 / 60 or 1 / 30)
        if now - SPM.lastFire < gap then return end
        SPM.lastFire = now
        pcall(function()
            local C = getgenv().VIREX_Clash
            if not C then C = { t = 0, n = 0 } getgenv().VIREX_Clash = C end
            if now - (C.t or 0) > 0.8 then C.n = 0 end
            C.t = now
            C.n += 1
            local S2 = getgenv().VIREX_Session
            if S2 then S2.spams += 1 end
        end)
        if getgenv().AutoSpamMode == "Keypress" and PF then
            PF()
        else
            fireParryRemote(System.curve.get_cframe())
            if getgenv().AutoSpamAnimationFix and PF then PF() end
        end
    end)
end

