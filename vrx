System.triggerbot = {}
local triggerbotCooldown = false
-- ===== TRIGGERBOT (v2) =====
-- * Mas rapido: escucha el cambio de "target" del balon (dispara en el MISMO frame en que el balon pasa a ti)
--   y ademas mira cada frame en PreSimulation (antes Heartbeat = un frame tarde). Usa el envio directo del motor.
-- * Un parry por balon: si el balon sigue viniendo y no se paro (lag), reintenta una vez a los 0.35 s.
-- * Smart Triggerbot: en vez de pegar nada mas apuntarte, mira velocidad y distancia del balon:
--   por encima de "Smart Speed" pega al instante; por debajo espera a que el balon este llegando (ping + margen).
-- * Con Auto Spam: mientras hay un choque de verdad, el Triggerbot se aparta y lo lleva el spam (no se pisan).
System.__triggerbot.__smart = false
System.__triggerbot.__smart_speed = 300
local TB = { armedFor = nil, firedAt = 0, retried = false, conns = setmetatable({}, { __mode = "k" }) }
local function tbGate() local g = getgenv().VIREX_ParryGate if not g then g = { last = 0, by = "", clashUntil = 0 } getgenv().VIREX_ParryGate = g end return g end
local function tbPing()
    local p = 60
    pcall(function() p = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return p
end
local function tbFire()
    local fire = getgenv().VIREX_EngineFire
    local ok = false
    if type(fire) == "function" then ok = pcall(fire) end
    if not ok then System.parry.execute() end
    if System.__properties.__play_animation then pcall(System.animation.play_grab_parry) end
    local g = tbGate()
    g.last, g.by = os.clock(), "trigger"
end
-- ¿toca pegar ya a este balon?
local function tbShouldFire(ball)
    local ch = LocalPlayer.Character
    local root = ch and ch.PrimaryPart
    if not root or root:FindFirstChild("SingularityCape") then return false end
    if ball:GetAttribute("target") ~= LocalPlayer.Name then return false end
    -- choque en marcha: lo lleva el Auto Spam
    if os.clock() < (tbGate().clashUntil or 0) then return false end
    if not System.__triggerbot.__smart then return true end
    local z = ball:FindFirstChild("zoomies")
    local vel = z and z.VectorVelocity or ball.AssemblyLinearVelocity
    local speed = vel.Magnitude
    if speed >= (tonumber(System.__triggerbot.__smart_speed) or 300) then return true end
    local toMe = root.Position - ball.Position
    local dist = toMe.Magnitude
    if dist <= 12 then return true end
    local approach = dist > 0.001 and vel:Dot(toMe.Unit) or 0
    if approach <= 1 then return false end
    local window = math.clamp(tbPing() / 1000 + 0.12, 0.12, 0.45)
    return dist / approach <= window
end
function System.triggerbot.trigger(ball)
    if triggerbotCooldown then return end
    if System.__triggerbot.__is_parrying then return end
    if System.__triggerbot.__parries > System.__triggerbot.__max_parries then return end
    if not tbShouldFire(ball) then return end
    local now = os.clock()
    if TB.armedFor == ball then
        -- ya se pego a este balon: un solo reintento si sigue viniendo (el anterior no llego)
        if TB.retried or now - TB.firedAt < 0.35 then return end
        TB.retried = true
    else
        TB.armedFor, TB.retried = ball, false
    end
    TB.firedAt = now
    triggerbotCooldown = true
    System.__triggerbot.__is_parrying = true
    System.__triggerbot.__parries = System.__triggerbot.__parries + 1
    tbFire()
    task.delay(0.08, function()
        triggerbotCooldown = false
        System.__triggerbot.__is_parrying = false
        if System.__triggerbot.__parries > 0 then System.__triggerbot.__parries = System.__triggerbot.__parries - 1 end
    end)
end
-- el balon cambia de objetivo: se rearma (y si ahora es a ti, se mira ya mismo, sin esperar al siguiente frame)
local function tbWatchBall(ball)
    if TB.conns[ball] then return end
    TB.conns[ball] = ball:GetAttributeChangedSignal("target"):Connect(function()
        if TB.armedFor == ball then TB.armedFor = nil end
        if System.__triggerbot.__enabled then pcall(System.triggerbot.trigger, ball) end
    end)
end
function System.triggerbot.loop()
    if not System.__triggerbot.__enabled then return end
    local balls = Workspace:FindFirstChild('Balls'); if not balls then return end
    for _, ball in pairs(balls:GetChildren()) do
        if ball:IsA('BasePart') and ball:GetAttribute("realBall") ~= false then
            tbWatchBall(ball)
            if ball:GetAttribute('target') == LocalPlayer.Name then
                System.triggerbot.trigger(ball)
                break
            end
        end
    end
end
function System.triggerbot.enable(enabled)
    System.__triggerbot.__enabled = enabled
    if enabled then
        if not System.__properties.__connections.__triggerbot then
            System.__properties.__connections.__triggerbot = RunService.PreSimulation:Connect(System.triggerbot.loop)
        end
    else
        if System.__properties.__connections.__triggerbot then
            System.__properties.__connections.__triggerbot:Disconnect()
            System.__properties.__connections.__triggerbot = nil
        end
        for b, c in pairs(TB.conns) do pcall(function() c:Disconnect() end) TB.conns[b] = nil end
        TB.armedFor = nil
        System.__triggerbot.__is_parrying = false
        System.__triggerbot.__parries = 0
        triggerbotCooldown = false
    end
end
  
