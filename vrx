			pcall(function() native = (crypt and (crypt.base64decode or (crypt.base64 and crypt.base64.decode))) or base64_decode end)
			if native then pcall(function() raw = native(data) end) end
			if type(raw) ~= "string" or raw:sub(2, 4) ~= "PNG" then
				local B = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
				local map, out, acc, bits = {}, {}, 0, 0
				for i = 1, 64 do map[B:sub(i, i)] = i - 1 end
				for ch in data:gmatch("[%w%+/]") do
					acc = acc * 64 + map[ch]
					bits += 6
					if bits >= 8 then
						bits -= 8
						out[#out + 1] = string.char(math.floor(acc / 2 ^ bits) % 256)
						acc = acc % 2 ^ bits
					end
				end
				raw = table.concat(out)
