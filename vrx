	local function lagExtra(speed)
		if not E.lagProtect then return 0 end
		local p = worstPing()
		local extraPing = math.clamp((p - 90) / 1000, 0, 0.35)
		local extraFrame = math.clamp(lastDt - 1 / 60, 0, 0.12)
		return speed * (extraPing + extraFrame)
	end

	-- ===== 9) AUTO PARRY =====
	local function hotbar() return Player:FindFirstChild("PlayerGui") and Player.PlayerGui:FindFirstChild("Hotbar") end
	local function apStep()
		-- con Triggerbot encendido, el que pega es el Triggerbot (antes pegaban los dos y se gastaba el parry)
		if System and System.__triggerbot and System.__triggerbot.__enabled then return end
		local ch = Player.Character
		local alive = workspace:FindFirstChild("Alive")
		if not ch or not alive or ch.Parent ~= alive or not ch.PrimaryPart then return end
		for _, ball2 in ipairs(E.Get_Balls()) do
			E.Get_Curve(ball2) -- (asi el parry se rearma en cuanto el balon cambia de objetivo)
			local zoomies = ball2:FindFirstChild("zoomies")
			-- (antes "return": si el primer balon de la lista no tenia velocidad, el Auto Parry no miraba los demas)
			if not zoomies then continue end
			local sinceParry = os.clock() - Last_Parry
			local PP = ch.PrimaryPart
			local maxShield = PP:FindFirstChild("MaxShield")
			local tornado = workspace.Runtime:FindFirstChild("Tornado")
			local abilities = ch:FindFirstChild("Abilities")
			local hb = hotbar()
			local visible = hb and hb:FindFirstChild("Ability") and hb.Ability:FindFirstChild("Duration") and hb.Ability.Duration.Visible
			local inf = abilities and abilities:FindFirstChild("Infinity")
			inf = inf and inf.Enabled and visible and Infinity_Ball
			local timeHole = abilities and abilities:FindFirstChild("Time Hole")
			timeHole = timeHole and timeHole.Enabled
			local cape = PP:FindFirstChild("SingularityCape")
			local blockGrad = hb and hb:FindFirstChild("Block") and hb.Block:FindFirstChild("UIGradient")
			local abilGrad = hb and hb:FindFirstChild("Ability") and hb.Ability:FindFirstChild("UIGradient")
			local target = ball2:GetAttribute("target")
			local speed = zoomies.VectorVelocity.Magnitude
			local ping = MOB and (worstPing() + 20) or E.Get_Ping()
			local lat = latMs()
			local reach = math.clamp(ping / 10, 10, 16) * (E.baseK or 1) + speed / (2.3497562749127492 + math.clamp(speed, 0, 425) * 0.002) * E.SDM
			-- nunca mas tarde que lo que recorre el balon durante tu ping + un frame (si no, el parry ya no llega)
			reach = math.max(reach, speed * (lat / 1000 + math.max(dtPeak, 1 / 60)) + 3)
			-- con pocos FPS (movil) el balon avanza mucho entre un frame y el siguiente: se suma ese trozo
			-- (a 60 FPS o mas vale 0, asi en PC no cambia nada)
			local frameComp = E.lagProtect and 0 or speed * math.clamp(lastDt - 1 / 60, 0, 0.08)
			local reachR = reach + (E.flags.Parry_Range or 0) + lagExtra(speed) + frameComp
			local bpos2 = ballPos(ball2)
			local dist = (PP.Position - bpos2).Magnitude
			-- TU MOVIMIENTO (correr, saltar, dash): lo que cuenta es la velocidad del balon RELATIVA a ti.
			-- Ademas el servidor te ve donde estabas hace medio ping: se suma ese trozo de camino.
			local myVel = PP.AssemblyLinearVelocity
			local mySpeed = myVel.Magnitude
			local relSpeed = (zoomies.VectorVelocity - myVel).Magnitude
			reachR = math.max(reachR, relSpeed * (lat / 1000 + math.max(dtPeak, 1 / 60)) + 3) + mySpeed * (lat / 2000)
			-- PELIGRO: el balon puede tocarte antes de que tu parry llegue al servidor. Entonces se para YA,
			-- aunque parezca que curva (al moverte rapido el balon apunta a donde estabas y parecia "curva")
			local danger = dist / math.max(relSpeed, 1) <= lat / 1000 + 2 * math.max(dtPeak, 1 / 60) + 0.05
			-- pegado a ti (por delante, por detras, de lado, saltando...): siempre peligro, venga como venga
			if dist <= 8 + mySpeed * (lat / 1000) then danger = true end
			-- GOLPE CON HABILIDAD (el rival la pega mucho mas fuerte hacia ti): la velocidad salta de golpe y
			-- llega antes de lo que tu ping deja reaccionar. Durante medio segundo despues del salto se para
			-- con mas margen (+0.12 s de tiempo y el alcance de esa velocidad).
			do
				E._spk = E._spk or setmetatable({}, { __mode = "k" })
				local rec = E._spk[ball2]
				if not rec then rec = { s = speed, untilT = 0 } E._spk[ball2] = rec end
				if target == Player.Name and speed > 120 and speed > math.max(rec.s * 1.6, rec.s + 120) then
					rec.untilT = os.clock() + 0.5
					logEv(string.format("AP     golpe fuerte: %.0f -> %.0f  d=%.1f", rec.s, speed, dist))
				end
				rec.s = speed
				if target == Player.Name and os.clock() < rec.untilT then
					reachR = math.max(reachR, speed * (lat / 1000 + math.max(dtPeak, 1 / 60) + 0.12) + 3)
					if dist / math.max(relSpeed, 1) <= lat / 1000 + 2 * math.max(dtPeak, 1 / 60) + 0.17 then danger = true end
				end
			end
			local curved = E.Is_Curved(ball2)
			local curved2 = E.Is_Curved2(ball2)
			if target == Player.Name then E.apCurve = { ball = ball2, curved = curved or curved2, t = os.clock() } end
			if inf or (visible and timeHole) then Parries = 0 return end
			if (visible and maxShield) or cape then Parries = 0 return end
			if target == Player.Name and tornado then
				local tt = (tornado:GetAttribute("TornadoTime") or 1) + 0.314159
				if Tornado_Time then
					if tick() - Tornado_Time < tt then return end
					Tornado_Time = nil
				end
			end
			-- Cooldown Protection: si el parry esta en espera, usa una habilidad que para el balon
			-- (solo con el balon YA encima: antes gastaba tu habilidad con el balon aun lejos, cuando el parry
			--  todavia se iba a recargar a tiempo)
			if target == Player.Name and E.flags.Cooldown_Protection and blockGrad and sinceParry > 0.5
				and blockGrad.Offset.Y <= 0.4 and danger then
				for _, n in ipairs(Parry_Abilities) do
					local a = abilities and abilities:FindFirstChild(n)
					if a and a.Enabled then
						Parried = true
						pcall(function() RS.Remotes.AbilityButtonPress:Fire() end)
						return
					end
				end
			end
			if target == Player.Name and abilGrad and abilGrad.Offset.Y == 0.5 and dist <= reach and GV.AutoAbility and sinceParry > 0.5 then
				for _, n in ipairs(Parry_Abilities) do
					local a = abilities and abilities:FindFirstChild(n)
					if a and a.Enabled then
						Parried = true
						pcall(function() RS.Remotes.AbilityButtonPress:Fire() end)
						return
					end
				end
			end
			if target == Player.Name and curved and not danger then continue end
			if target == Player.Name and sinceParry > 0.5 and curved2 and not danger and game.PlaceId ~= 15264892126 then continue end
			if E.flags.Phantom_Detection and target == Player.Name and Got_Phantomed then continue end
			-- REINTENTO: si despues de una ida y vuelta (tu ping) el balon SIGUE yendo a por ti, ese parry no entro
			-- (balon que se va por detras / curva / habilidad del rival). Antes se esperaba 0.65 s y morias.
			-- (solo con el balon ya encima: si aun esta lejos, el primer parry puede seguir valiendo)
			if target == Player.Name and Parried and danger
				and os.clock() - Last_Parry > math.max(0.22, lat * 2 / 1000 + 0.1) then
				Parried = false
				logEv(string.format("AP     reintento (el parry anterior no entro) d=%.1f", dist))
			end
			if E.lagProtect and target == Player.Name and Parried and dist <= reachR
				and os.clock() - Last_Parry > math.max(0.3, worstPing() * 2 / 1000 + 0.15) then
				Parried = false -- el parry anterior no llego (lag): se intenta otra vez
			end
			-- VENTANA DEL SERVIDOR: un parry aceptado solo vale ~0.5 s (atributo "ParryTime" del personaje).
			-- Si el balon tarda mas que eso en llegar, el parry se pierde y te deja 1.3 s sin parry.
			-- Asi que no se pulsa si el balon tarda en llegar mas que esa ventana (menos un margen),
			-- salvo peligro (balon encima, golpe fuerte...).
			local tooEarly = false
			do
				local win = tonumber(ch:GetAttribute("ParryTime")) or 0.5
				win = math.clamp(win, 0.2, 1)
				local appr = dist > 0.001 and (zoomies.VectorVelocity - myVel):Dot((PP.Position - bpos2).Unit) or 0
				if appr > 1 and not danger then
					local eta = dist / appr - lat / 2000 -- (el servidor recibe tu parry medio ping despues)
					if eta > win * 0.7 then tooEarly = true end
				end
			end
			if target == Player.Name and dist <= reachR and not Parried and tooEarly then
				if not E._earlyLogT or os.clock() - E._earlyLogT > 0.3 then
					E._earlyLogT = os.clock()
					logEv(string.format("AP     espera (llegaria en mas de la ventana) d=%.1f alcance=%.1f v=%.0f", dist, reachR, speed))
				end
			end
			if target == Player.Name and dist <= reachR and not Parried and not tooEarly then
				Play_Animation()
				E.Parry(Selected_Parry_Type)
				Last_Parry = os.clock()
				Parried = true
				pcall(function() local g = GV.VIREX_ParryGate if g then g.last, g.by = Last_Parry, "ap" end end)
				GV.VIREX_LastParry = { d = dist, a = reachR, s = speed, t = os.clock() }
				logEv(string.format("AP     d=%.1f alcance=%.1f v=%.0f rel=%.0f yo=%.0f%s lat=%.0fms fps=%.0f", dist, reachR, speed, relSpeed, mySpeed, danger and " PELIGRO" or "", lat, 1 / math.max(dtPeak, 1 / 240)))
				local t0 = os.clock()
				task.spawn(function()
					local pth = math.clamp(ping / 10, 5, 17)
					local bp = Ball_Properties(ball2)
					if not bp then return end
					local ep = Entity_Properties()
					if not ep then return end
					local sr = Spam_Service({ Ball = ball2, Ball_Properties = bp, Entity_Properties = ep, Ping = pth })
					if not sr or sr == 0 then return end
					while os.clock() - t0 < 0.65 and Parried do RunS.Heartbeat:Wait() end
					Parried = false
					if Parries >= 7 then return end
					Parries += 1
					task.delay(0.5, function() if Parries > 0 then Parries -= 1 end end)
					if blockGrad then
						blockGrad:GetPropertyChangedSignal("Offset"):Once(function()
							if blockGrad.Offset.Y < 0.5 and dist > sr then Parried = true t0 = os.clock() end
						end)
					end
				end)
			end
		end
	end
	function E.startAP()
		disc("ap")
		E.apOn = true
		conns.ap = RunS.PreSimulation:Connect(function()
			local ok, err = pcall(apStep)
			if not ok and not E._apErr then E._apErr = true warn("[VIREX Engine] " .. tostring(err)) end
		end)
		if E.flags.Notify then pcall(function() GV.VIREX_TopBanner({ title = "AUTO PARRY", text = "Enabled", width = 220, duration = 2 }) end) end
	end
	function E.stopAP()
		disc("ap")
		E.apOn = false
		if E.flags.Notify then pcall(function() GV.VIREX_TopBanner({ title = "AUTO PARRY", text = "Disabled", width = 220, duration = 2 }) end) end
	end

	-- ===== 10) AUTO SPAM (v2) =====
	-- 1) choque de verdad: el atributo "target" del balon va y viene entre tu y un rival, rapido y seguido
	--    (Clashing Threshold 1/2/3 = 1/2/3 idas y vueltas). Un parry tuyo solo ya no cuenta como choque.
	-- 2) momento: balon hacia ti = solo cuando de verdad esta llegando (tiempo de llegada <= ping + margen);
	--    balon hacia el rival = solo en choque muy pegado y muy rapido.
	-- 3) RESERVA AUTOMATICA: si el balon va demasiado rapido para el Auto Parry normal, el spam entra solo
	--    (aunque no haya choque) justo cuando el balon esta a punto de llegar.
	-- 4) PROTECCION DE COOLDOWN: no dispara justo despues de un parry que ya cubre ese balon
	--    (Auto Parry o Triggerbot), y al acabar el choque el Auto Parry queda listo para el siguiente balon.
	-- 5) TRIGGERBOT: con Triggerbot encendido, el spam solo entra en choques de verdad (sin reserva) y el
	--    Triggerbot se aparta mientras dura el choque: no se pisan ni gastan el parry el uno al otro.
	-- 6) SIN LAG: ritmo limitado (no un disparo por frame), la tecla de parry del juego como mucho cada 0.12 s,
	--    y las comprobaciones de habilidades se miran 5 veces por segundo, no cada frame.
	E.flags.Spam_Fallback = E.flags.Spam_Fallback ~= false
	E.flags.Fallback_Speed = E.flags.Fallback_Speed or 280
	local Gate = GV.VIREX_ParryGate or { last = 0, by = "", clashUntil = 0 }
	GV.VIREX_ParryGate = Gate
	local CL = { ball = nil, hist = {}, prev = nil }
	local function clashWatch(ball)
		if CL.ball == ball then return end
		disc("clashTarget")
		CL.ball, CL.hist, CL.prev = ball, {}, nil
		CL.meSince, CL.fbShot = os.clock(), nil
		if not ball then return end
		CL.prev = ball:GetAttribute("target")
		conns.clashTarget = ball:GetAttributeChangedSignal("target"):Connect(function()
			local t = ball:GetAttribute("target")
			local h = CL.hist
			h[#h + 1] = { t = os.clock(), from = CL.prev, to = t }
			if #h > 16 then table.remove(h, 1) end
			if t == Player.Name then CL.meSince = os.clock() end
			pcall(function() E.logEv("target " .. tostring(CL.prev == Player.Name and "TU" or CL.prev) .. " -> " .. tostring(t == Player.Name and "TU" or t)) end)
			CL.prev = t
		end)
	end
	-- cambios seguidos entre tu y el rival (del mas nuevo hacia atras); devuelve cuantos, hora del ultimo, intervalo medio
	local function clashState(me, foe)
		local n, newest, oldest, later = 0, nil, nil, nil
		for i = #CL.hist, 1, -1 do
			local h = CL.hist[i]
			if not ((h.from == me and h.to == foe) or (h.from == foe and h.to == me)) then break end
			if later and later - h.t > 0.55 then break end
			n += 1
			newest = newest or h.t
			oldest = h.t
			later = h.t
		end
		local avg = (n > 1 and newest and oldest) and (newest - oldest) / (n - 1) or math.huge
		return n, newest, avg
	end
	-- habilidades que bloquean el spam (se miran 5 veces por segundo)
	local abilT, abilBlock = 0, false
	local function abilityBlocked(ch)
		local now = os.clock()
		if now - abilT < 0.2 then return abilBlock end
		abilT = now
		abilBlock = false
		pcall(function()
			local hb = hotbar()
			local abilities = ch:FindFirstChild("Abilities")
			local visible = hb and hb:FindFirstChild("Ability") and hb.Ability:FindFirstChild("Duration") and hb.Ability.Duration.Visible
			local inf = abilities and abilities:FindFirstChild("Infinity")
			inf = inf and inf.Enabled and visible and Infinity_Ball
			local timeHole = abilities and abilities:FindFirstChild("Time Hole")
			timeHole = timeHole and timeHole.Enabled
			if inf or (visible and timeHole) then abilBlock = true Parries = 0 end
		end)
		return abilBlock
	end
	local lastSpam, lastKey, wasClash = 0, 0, false
	E.clashDebug = false -- ponlo a true para ver en la consola por que dispara / no dispara
	local function spamStep()
		if not (E.apOn or E.spamAlone) then return end
		local ch = Player.Character
		local alive = workspace:FindFirstChild("Alive")
		if not ch or not alive or ch.Parent ~= alive or not ch.PrimaryPart then return end
		local ball = E.Get_Ball()
		clashWatch(ball)
		if not ball then return end
		local zoomies = ball:FindFirstChild("zoomies")
		if not zoomies then return end
		if ch:GetAttribute("Pulsed") then return end
		if abilityBlocked(ch) then return end
		local now = os.clock()
		local PP = ch.PrimaryPart
		local me = Player.Name
		local target = ball:GetAttribute("target")
		local trig = System and System.__triggerbot and System.__triggerbot.__enabled

		-- rival = con quien va y viene el balon
		local foe
		for i = #CL.hist, 1, -1 do
			local h = CL.hist[i]
			if h.from == me and h.to then foe = h.to break end
			if h.to == me and h.from then foe = h.from break end
		end
		local n, newest, avg = 0, nil, math.huge
		if foe and foe ~= me then n, newest, avg = clashState(me, foe) end
		local need = 2 * math.clamp(tonumber(E.flags.Clashing_Threshold) or 1, 1, 3)
		local clash = n >= need and newest ~= nil and avg <= 0.45 and now - newest <= math.clamp(avg * 2.2, 0.25, 0.7)
			and (target == me or target == foe)
		if clash then Gate.clashUntil = now + 0.25 end
		if wasClash and not clash then
			-- el choque se acabo: el Auto Parry queda listo para el siguiente balon
			Parried = false
		end
		wasClash = clash

		local ping = latMs()
		local bpos = ballPos(ball)
		local vel = zoomies.VectorVelocity
		local speed = vel.Magnitude
		local toMe = PP.Position - bpos
		local dist = toMe.Magnitude
		-- velocidad RELATIVA (tu tambien te mueves: correr hacia el balon lo hace llegar antes)
		local myVel = PP.AssemblyLinearVelocity
		local relVel = vel - myVel
		local approach = dist > 0.001 and relVel:Dot(toMe.Unit) or 0
		local relSpeed = relVel.Magnitude
		-- ventana = latencia real (con jitter) + el peor frame reciente + un margen corto
		local window = math.clamp(ping / 1000 + math.max(dtPeak, 1 / 60) + (MOB and 0.08 or 0.06), 0.1, MOB and 0.45 or 0.4)
		-- peligro: el balon (contando tu movimiento) puede tocarte dentro de la ventana -> no se espera por "curva"
		local danger = target == me and (dist / math.max(relSpeed, 1) <= window or dist <= 8 + myVel.Magnitude * (ping / 1000))

		local fire, why = false, ""
		local fbStamp = nil
		local foeDistC = math.huge -- (distancia al rival del choque, para saber si es un choque MUY pegado)
		if clash then
			-- distancia maxima del choque (la formula de siempre)
			local foeChar = alive:FindFirstChild(foe)
			local foeRoot = foeChar and foeChar:FindFirstChild("HumanoidRootPart")
			local foeDist = foeRoot and (PP.Position - foeRoot.Position).Magnitude or math.huge
			foeDistC = foeDist
			local bp = Ball_Properties(ball)
			local sr = bp and Spam_Service({ Ball = ball, Ball_Properties = bp, Entity_Properties = { Distance = foeDist }, Ping = math.clamp(ping / 10, 10, 16.5) }) or 0
			if sr and sr > 0 and dist <= sr and foeDist <= sr then
				if target == me then
					if dist <= 10 or (approach > 1 and dist / approach <= window) then fire, why = true, "choque: llega" else why = "choque: aun lejos" end
				elseif (MOB and foeDist <= math.clamp(16 + speed / 30, 16, 30) and avg <= 0.35) or (foeDist <= math.clamp(14 + speed / 40, 14, 26) and avg <= 0.3) then
					-- (antes se pulsaba aunque el rival se escapara saltando: el parry se gastaba al aire, el juego
					--  lo dejaba en espera y cuando el balon volvia ya no habia parry -> muerte)
					-- solo si el balon esta CERCA DE TI (un parry solo cuenta con el balon a tu lado)
					-- y el rival no se esta alejando de ti
					local nearMe = dist <= math.clamp(10 + speed / 40, 10, 22)
					local away = 0
					if foeRoot then
						local dirF = foeRoot.Position - PP.Position
						if dirF.Magnitude > 0.001 then away = (foeRoot.AssemblyLinearVelocity - myVel):Dot(dirF.Unit) end
					end
					if not nearMe then
						why = "choque pegado: balon lejos de ti"
					elseif away > 10 and dist > 8 then
						why = "choque pegado: el rival se escapa"
					else
						fire, why = true, "choque pegado"
					end
				else
					why = "choque: va al rival"
				end
			else
				why = "choque: fuera de distancia"
			end
		elseif E.flags.Spam_Fallback and not trig and target == me and (speed >= (tonumber(E.flags.Fallback_Speed) or 280) or danger) then
			-- reserva = ULTIMA OPORTUNIDAD, nunca antes que el Auto Parry:
			--  * solo si el Auto Parry todavia no ha pegado desde que el balon vino a por ti
			--  * nunca con el balon curvando / en globo (el Auto Parry espera a que baje a proposito)
			--  * solo si viene recto hacia ti y esta a punto de tocarte
			--  * un solo disparo por balon (antes repetia cada 0.3 s y gastaba el parry)
			local ac = E.apCurve
			local curving = ac and ac.ball == ball and ac.curved and now - ac.t < 0.1
			local meSince = CL.meSince or 0
			-- el Auto Parry ya pego... salvo que despues de una ida y vuelta el balon siga a por ti (no entro)
			local apDone = Gate.last >= meSince and now - Gate.last < math.max(0.22, ping * 2 / 1000 + 0.1)
			local straight = approach >= speed * 0.8
			local eta = approach > 1 and dist / approach or math.huge
			if apDone then why = "reserva: el Auto Parry ya pego"
			elseif CL.fbShot == meSince and now - Gate.last < math.max(0.22, ping * 2 / 1000 + 0.1) then why = "reserva: ya disparo"
			elseif curving and not danger then why = "reserva: balon curvando"
			elseif E.flags.Phantom_Detection and Got_Phantomed then why = "reserva: phantom"
			elseif not straight and not danger then why = "reserva: no viene recto"
			elseif dist <= 10 or eta <= window * 0.8 or danger then
				fire, why = true, "reserva: ultima oportunidad"
				fbStamp = meSince
			else
				why = "reserva: aun no llega"
			end
		else
			why = "sin choque"
		end

		-- MOVIL: balon tan rapido que no da tiempo a reaccionar. Si el rival lo devuelve desde cerca, el balon
		-- te llega antes de que tu movil se entere de que va a por ti (ping). Entonces se pulsa ANTES:
		-- justo cuando el balon esta llegando al rival y la vuelta hasta ti dura menos que tu ping.
		local pre = false
		-- (solo si TU le mandaste el balon a ese jugador: es el que te lo va a devolver. En FFA antes
		--  pulsaba cuando el balon iba a cualquiera cerca, y gastaba el parry)
		local last = CL.hist[#CL.hist]
		local sentByMe = last ~= nil and last.from == me and last.to == target
		if MOB and not fire and not trig and target and target ~= me and speed >= 150 and sentByMe then
			local tc = alive:FindFirstChild(target)
			local troot = tc and tc:FindFirstChild("HumanoidRootPart")
			if troot then
				local dFoe = (PP.Position - troot.Position).Magnitude
				local dBallFoe = (bpos - troot.Position).Magnitude
				local reactT = ping / 1000 + math.max(dtPeak, 1 / 60) + 0.03
				if dFoe / speed <= reactT * 1.3 and (dBallFoe + dFoe) / speed <= window then
					fire, why, pre = true, "antes: no da tiempo a reaccionar", true
				else
					why = why .. " / antes: aun no"
				end
			end
		end

		-- ===== NO GASTAR EL PARRY (sale de tus registros diag) =====
		-- Cuando el servidor ACEPTA un parry abre una ventana (atributo "Parrying" = true) y pone el bloqueo
		-- en espera 1.3 s. Si el balon no llega en esa ventana, ese parry se pierde y el siguiente balon
		-- te mata (eso paso en tus muertes: parries de spam que llegaban justo DESPUES de un parry bueno).
		-- Por eso, salvo en un choque MUY pegado (donde el balon vuelve antes que tu ping):
		--  * no se pulsa si ya hay una ventana abierta (ese parry ya cubre el balon)
		--  * un solo parry por ida y vuelta (tu ping): se espera la respuesta del servidor antes de otro
		--  * nunca con el balon yendo a otro
		local tight = clash and foeDistC <= 14 and (foeDistC * 2 / math.max(speed, 1)) < ping / 1000 + 0.03
		if fire and not tight and now - (E.lastSuccess or 0) < ping / 1000 + 0.03 then
			fire, why = false, "acabas de parar: el balon se va"
		end
		-- mismo limite que el Auto Parry: el spam solo pulsa si el balon llega DENTRO de la ventana del servidor
		-- (si no, ese parry se pierde y te quedas 1.3 s sin parry: el "tarda en volver" que notabas)
		if fire and not tight and not danger then
			local winP = math.clamp(tonumber(ch:GetAttribute("ParryTime")) or 0.5, 0.2, 1)
			if approach <= 1 then
				fire, why = false, "el balon no viene hacia ti"
			elseif dist / approach - ping / 2000 > winP * 0.7 then
				fire, why = false, "aun no llega (fuera de la ventana)"
			end
		end
		if fire and not tight then
			if ch:GetAttribute("Parrying") == true then
				fire, why = false, "ventana de parry ya abierta"
			elseif now - lastSpam < ping / 1000 + 0.02 then
				fire, why = false, "esperando respuesta del servidor"
			elseif target ~= me then
				fire, why = false, "el balon va a otro"
			end
		end
		-- proteccion de cooldown: si un parry (Auto Parry / Triggerbot) acaba de cubrir este mismo balon, no se gasta otro
		if fire and not clash and not (pre and Gate.by == "spam") then
			if now - Gate.last < 0.14 then fire, why = false, "protegido: parry reciente" end
		end
		-- ritmo limitado (sin lag): mas rapido cuando el balon esta encima
		if fire then
			local gap = (dist <= 14 or (approach > 1 and dist / approach <= 0.08)) and (1 / 60) or (1 / 40)
			if MOB and clash then gap = 0 end -- movil: en choque, un parry cada frame
			if now - lastSpam < gap then fire = false end
		end
		if E.clashDebug and (not E._dbgT or now - E._dbgT > 0.25) then
			E._dbgT = now
			print(string.format("[VIREX Spam] n=%d avg=%.2f dist=%.1f speed=%.0f -> %s (%s)", n, avg == math.huge and -1 or avg, dist, speed, fire and "SPAM" or "no", why))
		end
		if not fire then return end
		if now - (E._logSpamT or 0) > 0.05 then
			E._logSpamT = now
			logEv(string.format("SPAM   %s  d=%.1f v=%.0f rel=%.0f yo=%.0f a=%s lat=%.0fms vent=%.2f fps=%.0f", why, dist, speed, relSpeed, myVel.Magnitude, target == me and "TU" or tostring(target), ping, window, 1 / math.max(dtPeak, 1 / 240)))
		end
		if fbStamp then CL.fbShot = fbStamp end
		lastSpam = now
		Gate.last, Gate.by = now, "spam"
		-- animacion / tecla del juego: como mucho cada 0.12 s (antes cada frame: daba lag y retraso al teclado)
		if now - lastKey >= 0.12 then
			lastKey = now
			if Is_Mobile then
				-- movil: tambien la tecla de parry del juego (como en PC); si el ejecutor no la deja, solo la animacion
				if MOB and E.flags.Mobile_Keys and E._vimOk ~= false then
					E._vimOk = Animation_Fix()
					if not E._vimOk then Parry_Animation() end
				elseif now - (E._animT or 0) >= 0.3 then
					E._animT = now
					Parry_Animation()
				end
			else
				Animation_Fix()
			end
		end
		E.Parry(Selected_Parry_Type)
		Parried = true
		Last_Parry = now
		pcall(function()
			local C = GV.VIREX_Clash
			if not C then C = { t = 0, n = 0 } GV.VIREX_Clash = C end
			if now - (C.t or 0) > 0.8 then C.n = 0 end
			C.t = now
			C.n += 1
			local S2 = GV.VIREX_Session
			if S2 then S2.spams += 1 end
		end)
	end
	function E.startSpam()
		disc("spam")
		E.spamOn = true
		conns.spam = RunS.PreSimulation:Connect(function() pcall(spamStep) end)
	end
	function E.stopSpam()
		disc("spam")
		disc("clashTarget")
		CL.ball, CL.hist, CL.prev = nil, {}, nil
		wasClash = false
		E.spamOn = false
	end

	-- ===== 11) Dribble Preclick: para justo cuando el rival hace dribble =====
	function E.setDribble(on)
		disc("dribMon") disc("dribHl") disc("dribChar")
		if not on then return end
		local lastDribble = 0
		conns.dribMon = workspace.Alive.DescendantAdded:Connect(function(d)
			if d.Name == "DRIBBLE_IMMUNITY" and d.Parent ~= Player.Character then lastDribble = tick() end
		end)
		local function hook(ch)
			disc("dribHl")
			conns.dribHl = ch.DescendantAdded:Connect(function(d)
				if d.Name == "FAKE_HIGHLIGHT" and E.apOn and tick() - lastDribble <= 1 and not E.Is_Curved() then
					Play_Animation()
					E.Parry(Selected_Parry_Type)
				end
			end)
		end
		if Player.Character then hook(Player.Character) end
		conns.dribChar = Player.CharacterAdded:Connect(hook)
	end

	-- ===== 12) Anti Double Jump: un solo salto extra controlado =====
	function E.setAntiDoubleJump(on)
		disc("adjState") disc("adjInput")
		if not on then return end
		local hum = (Player.Character or Player.CharacterAdded:Wait()):WaitForChild("Humanoid")
		local jumped, used = false, false
		conns.adjState = hum.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Jumping then jumped = true
			elseif new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then jumped, used = false, false end
		end)
		conns.adjInput = UIS.InputBegan:Connect(function(i, gp)
			if gp then return end
			if i.KeyCode == Enum.KeyCode.Space and jumped and not used then
				used = true
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end)
	end

	-- ===== 13) atajos de curva (Z / X / C / 4) =====
	function E.setCurveKeys(on)
		disc("curveKeys")
		if not on then return end
		conns.curveKeys = UIS.InputBegan:Connect(function(i, gp)
			if gp then return end
			local k, want = i.KeyCode, nil
			if k == Enum.KeyCode.Z or k == Enum.KeyCode.One then want = "Backwards"
			elseif k == Enum.KeyCode.X or k == Enum.KeyCode.Two then want = "Dot Pointer"
			elseif k == Enum.KeyCode.C or k == Enum.KeyCode.Three then want = "Dot"
			elseif k == Enum.KeyCode.Four then want = "FFA" end
			if want then
				Selected_Parry_Type = (Selected_Parry_Type == want) and "Camera" or want
				CurveType = Selected_Parry_Type
				pcall(function() GV.VIREX_TopBanner({ title = "CURVE", text = Selected_Parry_Type, width = 200, duration = 1.6 }) end)
			end
		end)
	end

	-- ===== arranque: el envio del parry se prepara en segundo plano =====
	task.spawn(function()
		local ok, res = pcall(createParrySender)
		if ok and type(res) == "function" then
			sendParry = res
			E.ok = true
			GV.VIREX_SendParry = res
			print("[VIREX Engine] parry listo (sin golpe manual)")
			-- todo lo que esperaba tu primer golpe arranca ya, y fuera los ganchos viejos (menos lag)
			pcall(function()
				_capturedRemote = _capturedRemote or game
				_capturedValid = true
				_tokenFound = true
				if _unhookIndex then _unhookIndex() end
				if _unhookNC then _unhookNC() end
			end)
		else
			warn("[VIREX Engine] no se pudo preparar el parry nuevo, se usa el viejo: " .. tostring(res))
		end
	end)
end)()

