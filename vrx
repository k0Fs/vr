	-- ===== cursores de VIREX (solo con raton) =====
	-- Van como cursor de verdad del juego (UserInputService.MouseIcon): se mueven igual de fluidos que el
	-- raton normal, sin el retraso de un dibujo que persigue al raton. Roblox pone el CENTRO de la imagen
	-- donde esta el raton, por eso cada imagen lleva la punta justo en su centro.
	-- flecha normal, dedo encima de cualquier cosa que se pueda pulsar, flechas dobles en el borde del panel (agrandar)
	local RZ = { zone = nil, rot = 0, active = false } -- (lo rellena el codigo de agrandar el panel)
	local CUR = { on = false, a = {}, tried = false, orig = nil, cur = nil }
	local GuiService = game:GetService("GuiService")
	local function curEnsure()
		if CUR.a.arrow then return true end
		if CUR.tried then return false end
		CUR.tried = true
		local IA = getgenv().VIREX_IconAsset
		if not IA then return false end
		for k, nm in pairs({ arrow = "cur_hw_arrow_v1", hand = "cur_hw_hand_v1", rz0 = "cur_hw_rz0_v1", rz90 = "cur_hw_rz90_v1", rz45 = "cur_hw_rz45_v1", rzm45 = "cur_hw_rzm45_v1" }) do
			local ok, asset = pcall(IA, nm)
			if ok and type(asset) == "string" and asset ~= "" then CUR.a[k] = asset end
		end
		return CUR.a.arrow ~= nil
	end
	-- ---- que se puede pulsar: botones y cajas de texto de VIREX y del juego (se apuntan solos al aparecer) ----
	-- se mira que boton visible hay debajo del raton. Los del panel se miran enteros (son pocos);
	-- los del juego por tandas cada frame, asi nunca da tirones aunque el juego tenga miles.
	local CLp, CLg, CLi = {}, {}, setmetatable({}, { __mode = "k" })
	local function layerOf(o)
		local a = o.Parent
		while a do
			if a:IsA("LayerCollector") then return a end
			a = a.Parent
		end
		return nil
	end
	local function watchBtn(o)
		if CLi[o] or not (o:IsA("GuiButton") or o:IsA("TextBox")) then return end
		CLi[o] = true
		local layer = layerOf(o)
		local e = { b = o, inset = (layer and layer:IsA("ScreenGui") and not layer.IgnoreGuiInset) and true or false }
		if o:IsDescendantOf(gui) then CLp[#CLp + 1] = e else CLg[#CLg + 1] = e end
	end
	local function watchTree(root0)
		pcall(function()
			for _, d in ipairs(root0:GetDescendants()) do pcall(watchBtn, d) end
			root0.DescendantAdded:Connect(function(d) task.defer(function() pcall(watchBtn, d) end) end)
		end)
	end
	local function visibleChain(b, mx, my)
		local a = b.Parent
		while a do
			if a:IsA("LayerCollector") then return a.Enabled ~= false end
			if a:IsA("GuiObject") then
				if not a.Visible then return false end
				if a:IsA("CanvasGroup") and a.GroupTransparency > 0.9 then return false end
				-- dentro de una lista con scroll: el boton tiene que estar en la parte que se ve
				if a.ClipsDescendants or a:IsA("ScrollingFrame") or a:IsA("CanvasGroup") then
					local p, s = a.AbsolutePosition, a.AbsoluteSize
					if mx < p.X or my < p.Y or mx > p.X + s.X or my > p.Y + s.Y then return false end
				end
			end
			a = a.Parent
		end
		return false
	end
	local function hits(e, mx, my, insetY, vs)
		local b = e.b
		if not b.Visible then return false end
		if e.inset then my = my - insetY end
		local p, s = b.AbsolutePosition, b.AbsoluteSize
		if mx < p.X or my < p.Y or mx > p.X + s.X or my > p.Y + s.Y then return false end
		-- fondos que tapan media pantalla (para cerrar avisos) no cuentan
		if s.X * s.Y > vs.X * vs.Y * 0.5 then return false end
		if b:GetAttribute("VX_NoHand") then return false end
		return visibleChain(b, mx, my)
	end
	local function sweep(list, i)
		-- quita del registro lo que ya no existe (intercambia con el ultimo)
		local e = list[i]
		if e and not e.b.Parent then
			CLi[e.b] = nil
			list[i] = list[#list]
			list[#list] = nil
			return true
		end
		return false
	end
	local lastHit, gIdx, gFound = nil, 1, false
	local function handHover(mx, my)
		local vs = gui.AbsoluteSize
		local insetY = 0
		pcall(function() insetY = GuiService:GetGuiInset().Y end)
		local result = false
		pcall(function()
			-- 1) el ultimo que se toco (lo normal es seguir encima)
			if lastHit and lastHit.b.Parent and hits(lastHit, mx, my, insetY, vs) then result = true return end
			lastHit = nil
			-- 2) los del panel, todos
			local i = 1
			while i <= #CLp do
				if not sweep(CLp, i) then
					if hits(CLp[i], mx, my, insetY, vs) then lastHit = CLp[i] result = true return end
					i += 1
				end
			end
			-- 3) los del juego, 300 por frame
			local n = #CLg
			if n == 0 then return end
			local checked = 0
			while checked < 300 and n > 0 do
				if gIdx > n then
					gIdx = 1
					if not gFound then break end
					gFound = false
				end
				if not sweep(CLg, gIdx) then
					if hits(CLg[gIdx], mx, my, insetY, vs) then lastHit = CLg[gIdx] gFound = true result = true return end
					gIdx += 1
				end
				checked += 1
				n = #CLg
			end
		end)
		return result
	end
	local watchStarted = false
	local function startWatch()
		if watchStarted then return end
		watchStarted = true
		watchTree(gui)
		pcall(function()
			local par = gui.Parent
			for _, c in ipairs(par:GetChildren()) do if c:IsA("ScreenGui") and c.Name:sub(1, 5) == "VIREX" and c ~= gui then watchTree(c) end end
			par.ChildAdded:Connect(function(c) if c:IsA("ScreenGui") and c.Name:sub(1, 5) == "VIREX" then watchTree(c) end end)
		end)
		pcall(function() watchTree(lp:WaitForChild("PlayerGui", 10)) end)
	end
	local RZKEY = { [0] = "rz0", [90] = "rz90", [45] = "rz45", [-45] = "rzm45" }
	RunService.RenderStepped:Connect(function()
		if not CUR.on then return end
