	local moodFor, muteScan, islandSync -- (se definen mas abajo)
	local function play(i)
		M.idx = i or M.idx
		M.tok = (M.tok or 0) + 1
		local my = M.tok
		sound:Stop()
		task.spawn(function()
			local id, err = load(M.idx)
			if my ~= M.tok then return end -- (ya elegiste otra)
			if not id then
				UI:notify({ title = "Music", text = err or "Could not load the song", duration = 3, allow = true })
				setPlaying(false)
				return
			end
			if my ~= M.tok then return end
			sound:Stop()
			sound.SoundId = id
			sound.Looped = M.loop
			sound.Volume = M.vol
			sound:Play()
			setPlaying(true)
			-- comprobar que de verdad suena
			local t0 = os.clock()
			while os.clock() - t0 < 6 and not sound.IsLoaded do task.wait(0.2) end
			if my ~= M.tok then return end
			if sound.IsLoaded and sound.TimeLength > 0 then
				if not sound.IsPlaying then sound:Play() end
				UI:notify({ title = "Now Playing", text = SONGS[M.idx].name, icon = "check", duration = 2.5 })
				pcall(moodFor, M.idx)
				pcall(muteScan)
				pcall(function() islandSync() end)
			else
				print("[VIREX Music] Roblox could not open the file (IsLoaded=" .. tostring(sound.IsLoaded) .. ")")
				UI:notify({ title = "Music", text = "Roblox can't play this file, try another mp3", duration = 3.5, allow = true })
				setPlaying(false)
			end
		end)
	end
