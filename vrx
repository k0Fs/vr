-- ===================== MY BACKGROUND: tu propia foto detras del panel (link o carpeta) =====================
;(function()
	local GV = getgenv()
	local custom = getcustomasset or getsynasset
	local BG = { shade = 0.3, on = false, files = {}, fi = 0 }
	local function note(t, ok) pcall(function() UI:notify({ title = "My Background", text = t, icon = ok and "check" or nil, duration = 3, allow = true }) end) end
	local function kind(d)
		if type(d) ~= "string" or #d < 200 then return nil end
		if d:sub(1, 4) == "\137PNG" then return "png" end
		if d:sub(1, 2) == "\255\216" then return "jpg" end
		return nil
	end
	local function hash(s)
		local h = 0
		for i = 1, #s do h = (h * 31 + s:byte(i)) % 2147483647 end
		return h
	end
	local function useFile(path)
		if not custom then return false, "Your executor can't load images" end
		local ok, id = pcall(custom, path)
		if not ok or type(id) ~= "string" or id == "" then return false, "Could not load the image" end
		BG.asset = id
		pcall(function() UI:set_bg_image(id, BG.shade) end)
		pcall(function() UI:set_panel_image(true) end)
		return true
	end
	local function fromLink(url)
		url = tostring(url or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if url == "" then return false, "Paste an image link first" end
		if not url:match("^https?://") then return false, "The link must start with https://" end
		if not (writefile and isfile and custom) then return false, "Your executor can't load images" end
		pcall(function() if makefolder and isfolder and not isfolder("VIREX") then makefolder("VIREX") end end)
		local base = "VIREX/mybg_" .. hash(url)
		for _, ext in ipairs({ "png", "jpg" }) do
			local p = base .. "." .. ext
			local have = false
			pcall(function() have = isfile(p) and kind(readfile(p)) ~= nil end)
			if have then return useFile(p) end
		end
		local ok, data = pcall(function() return game:HttpGet(url) end)
		if not ok then return false, "Download failed (bad link?)" end
		local k = kind(data)
		if not k then return false, "That link is not a .png / .jpg image" end
		local p = base .. "." .. k
		if not pcall(writefile, p, data) then return false, "Your executor can't save the image" end
		return useFile(p)
	end
	-- carpeta VIREX/Backgrounds: cada toque pone la siguiente foto
	local function nextFromFolder()
		if not (listfiles and isfolder) then return false, "Your executor can't read folders" end
		pcall(function() if makefolder and not isfolder("VIREX/Backgrounds") then makefolder("VIREX/Backgrounds") end end)
		local list = {}
		pcall(function()
			for _, f in ipairs(listfiles("VIREX/Backgrounds")) do
				local l = tostring(f):lower()
				if l:match("%.png$") or l:match("%.jpe?g$") then list[#list + 1] = f end
			end
		end)
		if #list == 0 then return false, "Put .png / .jpg files in workspace/VIREX/Backgrounds" end
		table.sort(list)
		BG.fi = BG.fi % #list + 1
		local ok, err = useFile(list[BG.fi])
		if ok then return true, "Image " .. BG.fi .. " / " .. #list end
		return false, err
	end

	pcall(function()
		local G = GV.VIREX_Tabs.Config:create_group("My Background", "left")
		pcall(function() G.box:SetAttribute("VIREX_Order", 8200) end)
		local tut = G:create_button(nil, { title = "How To Add", description = "Step by step: your own picture", button_text = "Tutorial", callback = function()
			pcall(function()
				GV.VIREX_ShowBoard({
					title = "Your own background", subtitle = "4 easy steps", button = "Got it",
					items = {
						{ "Get a picture", "Any .png or .jpg image you like." },
						{ "Upload it to catbox", "Go to catbox.moe and upload the picture.", copy = "https://catbox.moe" },
						{ "Copy the link", "catbox gives you a link. Copy it." },
						{ "Paste it in the script", "Paste the link in Image Link and tap Use." },
					},
				})
			end)
		end })
		local box = G:create_textbox("VIREX_MyBG_Link", { title = "Image Link", description = "Direct .png / .jpg link", placeholder = "https://...png" })
		G:create_button(nil, { title = "Use This Image", description = "Puts your picture behind the panel", button_text = "Use", callback = function()
			local link = box:get_value()
			note("Loading...", false)
			task.spawn(function()
				local ok, err = fromLink(link)
				if ok then
					BG.on = true
					pcall(function() UI._flags["VIREX_MyBG_On"] = true UI._changed() end)
					note("Your background is on", true)
				else
					note(err or "Could not load the image", false)
				end
			end)
		end })
		G:create_button(nil, { title = "My Folder", description = "Next picture from workspace/VIREX/Backgrounds", button_text = "Next", callback = function()
			local ok, msg = nextFromFolder()
			note(msg or (ok and "Done" or "Error"), ok)
		end })
		G:create_slider("VIREX_MyBG_Shade", { title = "Darkness", description = "Darker = easier to read", minimum = 0, maximum = 85, default = 30, rounding = true, suffix = "%", callback = function(v)
			BG.shade = v / 100
			if BG.asset then pcall(function() UI:set_bg_image(BG.asset, BG.shade) end) end
		end })
		G:create_button(nil, { title = "Remove", description = "Back to the normal background", button_text = "Remove", callback = function()
			BG.asset = nil
			BG.on = false
			pcall(function() UI._flags["VIREX_MyBG_On"] = false UI._changed() end)
			pcall(function() UI:set_bg_image(nil) end)
			note("Normal background", true)
		end })
		-- al ejecutar: si la ultima vez pusiste tu foto, sale otra vez
		if UI._flags and UI._flags["VIREX_MyBG_On"] == true then
			task.delay(2.5, function()
				local ok = fromLink(UI._flags["VIREX_MyBG_Link"])
				if ok then BG.on = true end
			end)
		end
	end)
end)()

