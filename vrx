			if os.clock() - (m.peT or 0) > 0.1 then
				m.peT = os.clock()
				m.pe.Color = ColorSequence.new(pick(FX.partName, hue))
				m.pe.Rate = math.clamp(20 + FX.spd / 12, 20, 90)
			end
		elseif m.pe then pcall(function() m.pe:Destroy() m.pa:Destroy() end) m.pe, m.pa = nil, nil end
	end)
	pcall(function()
